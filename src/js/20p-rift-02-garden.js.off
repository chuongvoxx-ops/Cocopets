        layout: [
          '########################################',
          '#S..t..........................#.......#',
          '#......t.......................#.......#',
          '#..L....P........t.....~~~.....#.......#',
          '#..............................#...E...#',
          '#.......h...........~~~~~~~~~~~#.......#',
          '#...................~~~~~~~~~~~#.......#',
          '#...................bbbbbbbbbbb........#',
          '#.......Q....g.....m~~~~~~~~~~~R.......#',
          '#......t...........~~~~~~~~~~~~........#',
          '########################################'],
        legend: Object.assign({ L: {}, P: {}, Q: {}, h: {}, R: {}, b: { tile: T_GAP }, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, S = { lamps: [mkLamp(H, marks.L[0], 0)], prisms: [mkPrism(H, X, marks.P[0], 3), mkPrism(H, X, marks.Q[0], 2)], shutters: [], receivers: [{ x: marks.R[0].x, y: marks.R[0].y, tx: marks.R[0].tx, ty: marks.R[0].ty, lit: false }], segs: [] };
          S.shutters.push(H.obj({ x: marks.h[0].x, y: marks.h[0].y, tx: marks.h[0].tx, ty: marks.h[0].ty, kind: 'shutter', open: false, h: 1.5, label: o => (o.open ? '' : 'Leaf shutter: open it'), draw: shutterDraw, use(o) { o.open = true; o.use = null; X.text(o.x, o.y - 1.5, 'The leaf swings aside', '#8FE0A6', 12); X.sfx.chirp(); } }));
          H.obj({ x: marks.R[0].x, y: marks.R[0].y, kind: 'bud', h: 1.6, label: o => (S.receivers[0].lit ? `Lit · ${Math.ceil(Math.max(0, 3 - held))}s` : 'The receiver bud'), draw: (c, Xs, Ys, T, o) => budDraw(c, Xs, Ys, T, S.receivers[0]) });
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, "Oruun's nursery");
          let held = 0, grown = false; const bridge = marks.b || [];
          X.after(2.4, () => X.banner('THE LIGHT ORCHARD', 'Stand at a prism flower to turn it a quarter', GOLD, 2.6, true, true));
          return { lamps: S.lamps,
            update(dt) { lampTick(S.lamps, dt); beamNet(X, S);
              if (S.receivers[0].lit) { held += dt; if (held >= 3 && !grown) { grown = true; bridge.forEach(p => X.setTile(p.tx, p.ty, T_BRIDGE)); X.retile(); X.banner('THE ROOTS GROW', 'Three broad segments bridge the ravine', '#8FE0A6', 2.4, true); X.flash(0.3, GOLD); X.sfx.fanfare(); } } else if (!grown) held = 0;
              if (grown && H.monstersLeft() === 0 && !self.done) { self.done = true; X.banner('THE ORCHARD IS QUIET', 'Cross to the nursery', GOLD, 2, true); } },
            goal() { const left = H.monstersLeft(); return grown ? (left ? `${left} monsters left` : 'Cross the root bridge') : S.receivers[0].lit ? `The bud is lit · hold ${Math.ceil(Math.max(0, 3 - held))}s` : S.lamps[0].charge <= 0 ? 'The lamp is drained: kill the moths' : 'Route the light to the bud'; },
            drawGround(c) { drawBeams(c, X, S); },
          };
        } },
      /* 2. Oruun: the seed nursery, four pebble beds as quadrants, three egg markers */
      { kind: 'boss', name: 'The Seed Nursery', boss: 'oruun', goal: 'Oruun the Cradle Tick',
        layout: [
          '############################',
          '#######~~~~~~~~~~~~~~#######',
          '####~~~..............~~~####',
          '###~.....e..........e..~####',
          '##~.....................~###',
          '##~.........B...........~###',
          '#~.......................~##',
          '#~.......................~##',
          '##~.........e...........~###',
          '##~.....................~###',
          '###~...................~####',
          '####~~~......S......~~~#####',
          '#######~~~~~~~~~~~~~~#######',
          '############################'],
        legend: { B: {}, e: {} },
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, mod = { safe: null };
          mod.layEggs = m => { const eye = Math.floor(Math.random() * marks.e.length); marks.e.forEach((p, i) => { const q = X.freeSpot(p.x, p.y, 0.4) || p; const e = X.spawnMon('egg', q.x, q.y, { pack: 521, eye: i === eye }); e.life = 7; X.g.total++; X.sparks(q.x, q.y, GOLD, 10, 4); }); X.text(m.x, m.y - m.r - 1.2, 'Three eggs fall', GOLD, 13); };
          mod.goal = () => mod.safe ? `A safe patch · ${Math.ceil(mod.safe.t)}s` : 'Oruun the Cradle Tick · break the eye egg for a safe patch';
          mod.update = dt => { for (const m of X.mons) { if (m.type !== 'egg') continue; if (m.dead) { if (!m.hatched && !m.seen) { m.seen = true; mod.onEggDeath(m); } continue; } if (m.life <= 0) EGG_HATCH(X, m); }
            if (mod.safe) { mod.safe.t -= dt; if (mod.safe.t <= 0) mod.safe = null; else if (Math.hypot(me.x - mod.safe.x, me.y - mod.safe.y) < 1.5) { me.inv = Math.max(me.inv, 0.15); } } };
          mod.onEggDeath = m => { if (m.eye) { mod.safe = { x: m.x, y: m.y, t: 12 }; X.banner('A SAFE PATCH', 'Nothing of Oruun\'s reaches you there', '#8FE0A6', 2, true); X.ring(m.x, m.y, 0.3, 1.5, 0.5, '#8FE0A6', 0.4); } };
          mod.drawGround = c => { const T = X.Tz(); // the pebble beds: four low quadrants
            [[7, 4], [20, 4], [7, 9], [20, 9]].forEach(([x, y]) => { const Xs = X.sx(x), Ys = X.sy(y); c.save(); c.globalAlpha = 0.35; c.fillStyle = CREAM; c.beginPath(); c.ellipse(Xs, Ys, T * 2.4, T * 1.3, 0, 0, TAU); c.fill(); c.restore(); });
            if (mod.safe) { const Xs = X.sx(mod.safe.x), Ys = X.sy(mod.safe.y); c.save(); c.globalCompositeOperation = 'lighter'; c.globalAlpha = 0.45 + 0.2 * Math.sin(X.g.t * 4); blitSized(c, glowSprite('#8FE0A6'), Xs - T * 1.8, Ys - T * 1.2, T * 3.6, T * 2.4); c.restore(); }
            marks.e.forEach(p => { const Xs = X.sx(p.x), Ys = X.sy(p.y); c.save(); c.strokeStyle = 'rgba(255,211,107,.5)'; c.lineWidth = 2; c.setLineDash([5, 5]); c.beginPath(); c.ellipse(Xs, Ys, T * 0.5, T * 0.3, 0, 0, TAU); c.stroke(); c.restore(); }); };
          return mod;
        } },
      /* 3. the Grafting Beds: three beds with stone reliefs, three living seeds; match them; the root barrier parts a
         third at a time */
      { kind: 'section', name: 'The Grafting Beds', goal: 'Plant each living seed in the bed with its mark',
        layout: [
          '######################################',
          '#S..............t...........xx.......#',
          '#...A......B......C.........xx.......#',
          '#...........................xx.......#',
          '#..t...........g............xx...E...#',
          '#...........................xx.......#',
          '#....1........2........3....xx.......#',
          '#........t..................xx.......#',
          '######################################'],
        legend: Object.assign({ A: {}, B: {}, C: {}, 1: {}, 2: {}, 3: {}, x: { tile: T_SOLID }, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, SHAPES = ['serrated', 'rounded', 'split'], R = X.R;
          const shuffle = a => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(R() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
          const bedShapes = shuffle(SHAPES.slice()), seedShapes = shuffle(SHAPES.slice()), barrier = (marks.x || []).slice().sort((a, b) => a.ty - b.ty);
          let carrying = null, grafts = 0, extra = false, opened = 0;
          const leaf = (c, x, y, r, shape, col) => { c.save(); c.translate(x, y); c.fillStyle = col; c.strokeStyle = LN; c.lineWidth = 1.4;
            if (shape === 'serrated') { c.beginPath(); c.moveTo(0, -r); for (let i = 0; i < 6; i++) { const u = i / 5; c.lineTo(r * 0.6 * Math.sin(u * Math.PI) + r * 0.15, -r + u * 2 * r); c.lineTo(r * 0.45 * Math.sin((u + 0.08) * Math.PI), -r + (u + 0.08) * 2 * r); } c.lineTo(0, r); for (let i = 5; i >= 0; i--) { const u = i / 5; c.lineTo(-r * 0.45 * Math.sin((u + 0.08) * Math.PI), -r + (u + 0.08) * 2 * r); c.lineTo(-r * 0.6 * Math.sin(u * Math.PI) - r * 0.15, -r + u * 2 * r); } c.closePath(); }
            else if (shape === 'rounded') { c.beginPath(); c.ellipse(0, 0, r * 0.7, r, 0, 0, TAU); }
            else { c.beginPath(); c.moveTo(0, r); c.quadraticCurveTo(-r * 0.9, 0, -r * 0.5, -r); c.lineTo(0, -r * 0.2); c.lineTo(r * 0.5, -r); c.quadraticCurveTo(r * 0.9, 0, 0, r); c.closePath(); }
            c.fill(); c.stroke(); c.beginPath(); c.moveTo(0, r * 0.9); c.lineTo(0, -r * 0.5); c.stroke(); c.restore(); };
          const seedDraw = (c, Xs, Ys, T, o) => { if (o.taken) return; const r = T * 0.26; c.save(); c.translate(Xs, Ys - T * 0.15); c.fillStyle = 'rgba(0,0,0,.3)'; c.beginPath(); c.ellipse(0, T * 0.3, r * 1.6, r * 0.5, 0, 0, TAU); c.fill(); c.fillStyle = '#8A7A5A'; c.strokeStyle = LN; c.lineWidth = 1.5; c.beginPath(); c.ellipse(0, T * 0.15, r * 1.5, r * 0.55, 0, 0, TAU); c.fill(); c.stroke();
            c.beginPath(); c.ellipse(0, 0, r * 0.8, r, 0, 0, TAU); c.fillStyle = shade(c, CREAM, r, -r * 0.2, -r * 0.4, 0.4); c.fill(); c.stroke(); leaf(c, 0, 0, r * 0.55, o.shape, JADE); c.restore(); };
          const seeds = [1, 2, 3].map((n, i) => H.obj({ x: marks[String(n)][0].x, y: marks[String(n)][0].y, kind: 'seed', n, shape: seedShapes[i], taken: false, home: { x: marks[String(n)][0].x, y: marks[String(n)][0].y }, h: 1.1, label: o => (o.taken ? '' : `Living seed · ${o.shape} mark`), draw: seedDraw,
            use(o) { if (carrying) { X.text(me.x, me.y - 1.1, 'Hands full', '#FFFFFF', 12); return; } o.taken = true; carrying = o; o.use = null; X.text(me.x, me.y - 1.1, `Took the ${o.shape}-marked seed`, CREAM, 12); X.sfx.chirp(); } }));
          seeds.forEach(s => { s.use0 = s.use; });
          const bedDraw = (c, Xs, Ys, T, o) => { c.save(); c.translate(Xs, Ys); c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, T * 0.2, T * 1.1, T * 0.45, 0, 0, TAU); c.fill(); c.fillStyle = shade(c, '#5A3A2A', T, 0, 0, 0.3); c.strokeStyle = LN; c.lineWidth = 1.6; c.beginPath(); c.ellipse(0, 0, T * 1.0, T * 0.42, 0, 0, TAU); c.fill(); c.stroke();
            // the stone relief behind the bed
            c.fillStyle = '#8E8A80'; GFX.rr(c, -T * 0.5, -T * 1.6, T * 1.0, T * 1.1, 6); c.fill(); c.stroke(); leaf(c, 0, -T * 1.05, T * 0.38, o.shape, '#C9C4B4');
            if (o.open) { glowAt(c, 0, -T * 0.3, T * 1.2, CREAM, 0.5); for (let i = 0; i < 6; i++) { const a = i / 6 * TAU + X.g.t * 0.3; c.fillStyle = CREAM; c.beginPath(); c.ellipse(Math.cos(a) * T * 0.45, -T * 0.3 + Math.sin(a) * T * 0.3, T * 0.3, T * 0.16, a, 0, TAU); c.fill(); c.strokeStyle = LN; c.lineWidth = 1.2; c.stroke(); } c.fillStyle = GOLD; c.beginPath(); c.arc(0, -T * 0.3, T * 0.18, 0, TAU); c.fill(); }
            if (o.sprout) { c.strokeStyle = LN; c.lineWidth = 5; c.beginPath(); c.moveTo(0, 0); c.quadraticCurveTo(T * 0.3, -T * 0.6, T * 0.1, -T * 1.0); c.stroke(); c.strokeStyle = '#7A4C9E'; c.lineWidth = 3; c.stroke(); for (let i = 0; i < 4; i++) { c.fillStyle = '#B98BE0'; tri(c, T * (0.1 + (i % 2 ? 0.25 : -0.2)), -T * (0.3 + i * 0.2), T * 0.1, i % 2 ? 0 : Math.PI); c.fill(); } }
            c.restore(); };
          const beds = ['A', 'B', 'C'].map((ch, i) => H.obj({ x: marks[ch][0].x, y: marks[ch][0].y, kind: 'bed', shape: bedShapes[i], open: false, sprout: null, r: 1.2, h: 2.0, label: o => (o.open ? 'A blossom opened' : o.sprout ? 'Thorn sprout: uproot it' : `Bed · ${o.shape} relief`), draw: bedDraw,
            use(o) {
              if (o.open) return;
              if (o.sprout) { const s = o.sprout; o.sprout = null; if (carrying) { s.taken = false; s.x = me.x; s.y = me.y + 0.6; s.use = s.use0; X.text(o.x, o.y - 1.2, 'Uprooted: the seed lies here', '#FFFFFF', 12); } else { carrying = s; X.text(o.x, o.y - 1.2, 'Uprooted: took the seed back', CREAM, 12); } X.sfx.chirp(); return; }
              if (!carrying) return;
              const s = carrying; carrying = null;
              if (s.shape === o.shape) { o.open = true; grafts++; X.banner('A BLOSSOM OPENS', `Its roots pull the barrier apart (${grafts}/3)`, CREAM, 2.2, true); X.sfx.fanfare(); X.sparks(o.x, o.y - 0.5, GOLD, 16, 6);
                const third = Math.ceil(barrier.length / 3); barrier.slice(opened, opened + third).forEach(p => X.setTile(p.tx, p.ty, T_FLOOR)); opened += third; X.retile();
                if (grafts === 2 && !extra) { extra = true; X.after(0.8, () => { const p0 = barrier[Math.min(barrier.length - 1, opened)]; for (let i = 0; i < 2; i++) { const q = X.freeSpot(p0.x - 1.5, p0.y + i * 1.2 - 0.6, 0.35) || p0; X.spawnMon('thornling', q.x, q.y, { aggro: true, pack: 522 }); X.g.total++; X.sparks(q.x, q.y, '#B98BE0', 10, 4); } X.text(p0.x - 1.5, p0.y - 1, 'Thornlings tear out of the barrier', '#B98BE0', 12); }); } }
              else { o.sprout = s; X.text(o.x, o.y - 1.4, 'Wrong bed: a thorn sprout grows', '#B98BE0', 12); X.sfx.wrong(); X.sparks(o.x, o.y - 0.5, '#7A4C9E', 10, 4); }
            } }));
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, 'The conservatory');
          return {
            update(dt) { if (!self.done && grafts === 3 && extra && H.monstersLeft() === 0) { self.done = true; barrier.slice(opened).forEach(p => X.setTile(p.tx, p.ty, T_FLOOR)); X.retile(); X.banner('THE ROOTS PART', 'Walk through to the conservatory', '#8FE0A6', 2.4, true); X.flash(0.3, CREAM); X.sfx.fanfare(); } },
            goal() { return carrying ? `Carrying the ${carrying.shape} seed · find its bed (${grafts}/3)` : self.done ? 'Walk through the parted roots' : `Blossoms ${grafts}/3${extra && H.monstersLeft() ? ` · ${H.monstersLeft()} thornlings` : ''}`; },
            drawOver(c) { if (!carrying) return; const T = X.Tz(); seedDraw(c, X.sx(me.x), X.sy(me.y) - T * 1.2 - Math.sin(X.g.t * 3) * T * 0.05, T, { shape: carrying.shape }); },
          };
        } },
      /* 4. Velis: the conservatory, three prism flowers on its edges and a single central seed-lamp */
      { kind: 'boss', name: 'The Glassless Conservatory', boss: 'velis', goal: 'Velis the Glasswing',
        layout: [
          '################################',
          '#..............P...............#',
          '#..............................#',
          '#..............................#',
          '#..............................#',
          '#..............B...............#',
          '#..............................#',
          '#..............................#',
          '#P.............L..............P#',
          '#..............................#',
          '#..............................#',
          '#..............................#',
          '#..............................#',
          '#..............S...............#',
          '################################'],
        legend: { B: {}, P: {}, L: {} },
        make(X, self, H) {
          const marks = X.M.marks, S = { lamps: [], prisms: [], receivers: [], segs: [], boss: null }, mod = { lamps: S.lamps };
          // the lamp lights all four ways; each prism sends its light on in the direction it faces
          [0, 1, 2, 3].forEach(d => S.lamps.push(mkLamp(H, marks.L[0], d, d ? { draw: null, label: '', r: 0 } : {})));
          marks.P.forEach(p => S.prisms.push(mkPrism(H, X, p, p.ty < 3 ? 1 : p.tx < 5 ? 0 : 2)));
          mod.onFold = m => { X.banner('WING SHUTTERS', 'Turn a prism so its light reaches the shielded side', ROSE, 2.2, true); };
          mod.summonDrainer = m => { const q = X.freeSpot(marks.L[0].x + 2, marks.L[0].y - 1, 0.35) || marks.L[0]; X.spawnMon('pollenmoth', q.x, q.y, { aggro: true, pack: 523 }); X.g.total++; X.banner('A MOTH DRAINS THE LAMP', 'Kill it first, then turn a prism', GOLD, 2.2, true); };
          mod.goal = () => { const b = X.boss; return b && b.guardA != null ? (b.shieldOpen > 0 ? `Shield open · ${Math.ceil(b.shieldOpen)}s: strike!` : 'Velis is shielded: light the folded wings') : 'Velis the Glasswing'; };
          mod.update = dt => { lampTick(S.lamps, dt); S.boss = X.boss; beamNet(X, S); const b = X.boss; if (!b || b.dead) return;
            if (S.bossHit && b.guardA != null && b.shieldOpen <= 0) { const from = Math.atan2(DIRS[S.bossHitFrom][1], DIRS[S.bossHitFrom][0]) + Math.PI; if (Math.abs(DunAI.angTo(b.guardA, from)) < 1.3) { b.shieldOpen = 10; X.banner('THE EYE LIGHTS', 'The wings open for ten seconds', GOLD, 2, true); X.flash(0.3, GOLD); X.sfx.fanfare(); X.ring(b.x, b.y, 0.3, 3, 0.6, GOLD, 0.4); } } };
          mod.drawGround = c => { drawBeams(c, X, S); const b = X.boss; if (b && !b.dead && b.guardA != null && b.shieldOpen <= 0) { const T = X.Tz(), Xs = X.sx(b.x), Ys = X.sy(b.y); c.save(); c.globalAlpha = 0.35; c.strokeStyle = ROSE; c.lineWidth = 5; c.beginPath(); c.ellipse(Xs, Ys, T * 2.4, T * 1.4, 0, b.guardA - 1.25, b.guardA + 1.25); c.stroke(); c.restore(); } };
          return mod;
        } },
      /* 5. the Seedling Pilgrimage: a root path round the stump; three lit patches; a seedling that walks lamp to lamp */
      { kind: 'section', name: 'The Seedling Pilgrimage', goal: 'Light the next patch and bring the seedling to it',
        layout: [
          '############################################################',
          '#S..........................................~~~~~..........#',
          '#.....1.........k...........2.........g..........3.....E...#',
          '#.....a.....................a....................a.........#',
          '#.........~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~..........#',
          '############################################################'],
        legend: Object.assign({ 1: {}, 2: {}, 3: {}, a: {}, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, patches = [1, 2, 3].map(n => ({ x: marks[String(n)][0].x, y: marks[String(n)][0].y, lit: n === 1 })), lamps = marks.a.map((p, i) => mkLamp(H, p, 0, { on: false, r: 1.0, label: o => (o.broken ? 'Repair the lamp' : o.on ? '' : 'Seed-lamp: light the next patch'), use(o) { if (o.broken) { o.broken = false; o.charge = 0.6; X.text(o.x, o.y - 1.5, 'Repaired', '#8FE0A6', 12); X.sfx.chirp(); return; } if (o.on) return; o.on = true; X.text(o.x, o.y - 1.5, 'The next patch lights', GOLD, 12); X.sfx.chirp(); } }));
          const seed = { x: patches[0].x, y: patches[0].y, leg: 0, walking: false, ph: 0 };
          let finale = false, finaleSpawned = false;
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, "Vhorru's clearing");
          X.after(2.4, () => X.banner('THE SEEDLING PILGRIMAGE', 'Light the lamp by each patch; the seedling walks to the next', GOLD, 2.8, true, true));
          const lampOf = i => lamps[i];
          return { lamps,
            update(dt) { lampTick(lamps, dt); seed.ph += dt * 5;
              for (const L of lamps) if (L.charge <= 0 && !L.broken) { L.broken = true; L.on = false; L.use = L.use0 || L.use; X.text(L.x, L.y - 1.5, 'The lamp is disabled', '#B98BE0', 12); }
              lamps.forEach(L => { if (!L.use0) L.use0 = L.use; });
              if (seed.leg < 2) { const L = lampOf(seed.leg), next = patches[seed.leg + 1]; next.lit = L.on && !L.broken && L.charge > 0;
                if (next.lit) { const dx = next.x - seed.x, dy = next.y - seed.y, d = Math.hypot(dx, dy); if (d > 0.2) { seed.walking = true; seed.x += dx / d * 1.6 * dt; seed.y += dy / d * 1.6 * dt; } else { seed.walking = false; seed.leg++; X.banner(`PATCH ${seed.leg + 1} REACHED`, seed.leg < 2 ? 'Light the next lamp' : 'Two moths come from both sides', GOLD, 2, true); X.sfx.fanfare(); if (seed.leg === 2) { finale = true; } } } else seed.walking = false; }
              if (finale && !finaleSpawned) { finaleSpawned = true; [[-4, 0], [4, 0]].forEach(([dx, dy]) => { const q = X.freeSpot(patches[2].x + dx, patches[2].y + dy, 0.35) || patches[2]; X.spawnMon('pollenmoth', q.x, q.y, { aggro: true, pack: 524 }); X.g.total++; }); }
              if (finale && !self.done && H.monstersLeft() === 0) { self.done = true; X.banner('THE BARK OPENS', 'The seedling opens the doorway into the stump', '#8FE0A6', 2.4, true); X.flash(0.3, CREAM); X.sfx.fanfare(); } },
            goal() { if (self.done) return 'Enter the stump'; if (finale) return `Defend the seedling · ${H.monstersLeft()} moths`; const L = lampOf(seed.leg); return L.broken ? `Lamp ${seed.leg + 1} is disabled: repair it` : L.on ? (seed.walking ? 'The seedling walks' : 'Clear the way') : `Light lamp ${seed.leg + 1} to lead the seedling on`; },
            drawGround(c) { const T = X.Tz();
              patches.forEach((p, i) => { const Xs = X.sx(p.x), Ys = X.sy(p.y); c.save(); c.globalCompositeOperation = 'lighter'; c.globalAlpha = p.lit ? 0.5 + 0.2 * Math.sin(X.g.t * 3) : 0.12; blitSized(c, glowSprite(GOLD), Xs - T * 1.6, Ys - T * 1.1, T * 3.2, T * 2.2); c.restore(); });
              if (seed.leg < 2 && patches[seed.leg + 1].lit) { c.save(); c.globalAlpha = 0.6; c.strokeStyle = GOLD; c.lineWidth = 2; c.setLineDash([6, 6]); c.beginPath(); c.moveTo(X.sx(seed.x), X.sy(seed.y)); c.lineTo(X.sx(patches[seed.leg + 1].x), X.sy(patches[seed.leg + 1].y)); c.stroke(); c.restore(); }
              // the seedling: a round cream body, two stubby root feet, one jade leaf
              const Xs = X.sx(seed.x), Ys = X.sy(seed.y), r = T * 0.26, st2 = seed.walking ? Math.sin(seed.ph) : 0; c.save(); c.translate(Xs, Ys - Math.abs(st2) * r * 0.2); c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, r * 0.6, r * 1.1, r * 0.4, 0, 0, TAU); c.fill();
              [-1, 1].forEach(sd => { c.strokeStyle = LN; c.lineWidth = r * 0.35; c.lineCap = 'round'; c.beginPath(); c.moveTo(sd * r * 0.35, r * 0.3); c.lineTo(sd * r * 0.5 + sd * st2 * r * 0.2, r * 0.75); c.stroke(); c.strokeStyle = '#B8A070'; c.lineWidth = r * 0.18; c.stroke(); });
              c.beginPath(); c.arc(0, -r * 0.1, r, 0, TAU); c.fillStyle = shade(c, CREAM, r, -r * 0.3, -r * 0.4, 0.4); c.fill(); c.strokeStyle = LN; c.lineWidth = 2; c.stroke();
              leafShape(c, r * 0.1, -r * 1.1, r * 0.55, X.g.t); [[-0.3, -0.2], [0.3, -0.2]].forEach(([x, y]) => { c.fillStyle = INK; c.beginPath(); c.arc(x * r, y * r, r * 0.11, 0, TAU); c.fill(); }); c.fillStyle = ROSE; c.beginPath(); c.arc(0, r * 0.15, r * 0.12, 0, TAU); c.fill(); c.restore(); },
          };
          function leafShape(c, x, y, r, t) { c.save(); c.translate(x, y); c.rotate(-0.5 + Math.sin(t * 2) * 0.1); c.fillStyle = JADE; c.strokeStyle = LN; c.lineWidth = 1.4; c.beginPath(); c.moveTo(0, 0); c.quadraticCurveTo(r * 0.9, -r * 0.9, r * 1.6, -r * 0.2); c.quadraticCurveTo(r * 0.8, r * 0.3, 0, 0); c.fill(); c.stroke(); c.restore(); }
        } },
      /* 6. Vhorru: the hollow stump's clearing, five blossoms in alcoves round the rim, three prism flowers */
      { kind: 'boss', name: 'The Hollow Stump', boss: 'vhorru', goal: 'Vhorru the Root of a Thousand Young',
        layout: [
          '####################################',
          '##############....f....#############',
          '##########..................########',
          '########......................######',
          '######..........................####',
          '#####............................###',
          '####..............................##',
          '####..............P...............##',
          '###f..............................f#',
          '###..............B.................#',
          '###................................#',
          '####..P......................P....##',
          '####..............................##',
          '#####............................###',
          '######f......................f..####',
          '########...............S......######',
          '##########..................########',
          '####################################'],
        legend: { B: {}, f: {}, P: {} },
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, S = { lamps: [], prisms: [], receivers: [], segs: [] }, mod = { lamps: S.lamps, marked: -1, pulse: 0, closed: false };
          // each prism flower is its own light here: the lamp of the clearing is the sky
          marks.P.forEach((p, i) => { const pr = mkPrism(H, X, p, i); S.prisms.push(pr); S.lamps.push({ x: p.x, y: p.y, tx: p.tx, ty: p.ty, get dir() { return pr.dir; }, charge: 1, drainT: 0 }); });
          const blossoms = marks.f.map((p, i) => ({ x: p.x, y: p.y, tx: p.tx, ty: p.ty, i, lit: false, open: true }));
          S.receivers = blossoms; const prismSeg = (seg, b) => { const [x0, y0, x1, y1] = seg; const L = Math.hypot(x1 - x0, y1 - y0) || 1, t = Math.max(0, Math.min(1, ((b.x - x0) * (x1 - x0) + (b.y - y0) * (y1 - y0)) / (L * L))); return Math.hypot(b.x - (x0 + (x1 - x0) * t), b.y - (y0 + (y1 - y0) * t)) < 1.2; };
          mod.bloomBusy = () => mod.pulse > 0;
          mod.fallingYoung = m => { for (let i = 0; i < 2; i++) { const a = Math.random() * TAU, q = X.freeSpot(me.x + Math.cos(a) * 3, me.y + Math.sin(a) * 3, 0.4) || me; const e = X.spawnMon('egg', q.x, q.y, { pack: 525 }); e.life = 7; X.g.total++; X.sparks(q.x, q.y, '#E04FA3', 10, 4); } X.text(me.x, me.y - 1.6, 'Two eggs fall: break them', '#E04FA3', 13); };
          mod.starlessBloom = (m, late) => { mod.closed = true; mod.marked = Math.floor(Math.random() * blossoms.length); mod.pulse = 8; mod.late = late; mod.swapped = false; blossoms.forEach(b => { b.open = false; }); X.banner('STARLESS BLOOM', `Open blossom ${mod.marked + 1} with a prism and gather inside`, '#E04FA3', 2.6, true); X.sfx.hum();
            if (late) { const bl = blossoms[mod.marked], a = Math.atan2(bl.y - m.y, bl.x - m.x), len = Math.hypot(bl.x - m.x, bl.y - m.y); X.zone({ kind: 'warn', shape: 'line', own: 'enemy', x: m.x, y: m.y, a, len: len * 0.8, w: 1.2, life: 7.5, max: 7.5, color: '#E04FA3', src: m }); mod.rootLane = { x: m.x, y: m.y, a, len: len * 0.8 }; } };
          mod.bossTick = (m, dt) => { if (mod.pulse <= 0) return; mod.pulse -= dt;
            if (mod.late && !mod.swapped && mod.pulse < 4) { mod.swapped = true; mod.marked = (mod.marked + 1 + Math.floor(Math.random() * (blossoms.length - 1))) % blossoms.length; X.banner('THE SAFE BLOSSOM CHANGES', `Blossom ${mod.marked + 1} now`, GOLD, 2, true); X.sfx.wrong(); }
            if (mod.rootLane && X.inLine(mod.rootLane.x, mod.rootLane.y, mod.rootLane.a, mod.rootLane.len, 1.2) && me.inv <= 0) { X.hurtPet(m.dmg * 0.4, m); me.inv = 0.5; }
            if (mod.pulse <= 0) { mod.pulse = 0; const b = blossoms[mod.marked], inside = b.open && Math.hypot(me.x - b.x, me.y - b.y) < 1.7; X.flash(0.6, '#E04FA3'); X.shake(16, 0.6); X.boom(m.x, m.y, 4, '#E04FA3', '#FFFFFF', { n: 40, shake: 14 }); X.ring(m.x, m.y, 0.5, 14, 1.2, '#E04FA3', 0.5); if (!inside) X.hurtPet(m.dmg * 3, m); else X.text(me.x, me.y - 1.4, 'Sheltered!', '#8FE0A6', 14); X.sfx.crash(); mod.closed = false; mod.marked = -1; mod.rootLane = null; blossoms.forEach(q => { q.open = true; }); X.banner(inside ? 'THE PULSE PASSES' : 'THE PULSE', inside ? 'The blossoms open again' : 'Caught outside the cup', inside ? '#8FE0A6' : '#E04FA3', 2, true); } };
          mod.goal = () => mod.pulse > 0 ? `Blossom ${mod.marked + 1}: ${blossoms[mod.marked].open ? 'open — get inside' : 'turn a prism to it'} · ${Math.ceil(mod.pulse)}s` : 'Vhorru · break the eggs, stand between the root lanes';
          mod.update = dt => { for (const m of X.mons) { if (m.type !== 'egg' || m.dead) continue; if (m.life <= 0) EGG_HATCH(X, m); }
            beamNet(X, S); if (mod.closed) blossoms.forEach(b => { b.open = b.lit || S.segs.some(seg => prismSeg(seg, b)); }); };
          mod.drawGround = c => { drawBeams(c, X, S); const T = X.Tz();
            blossoms.forEach(b => { const Xs = X.sx(b.x), Ys = X.sy(b.y), mk = mod.marked === b.i; c.save(); if (mk) { c.globalCompositeOperation = 'lighter'; c.globalAlpha = 0.5 + 0.3 * Math.sin(X.g.t * 6); blitSized(c, glowSprite(GOLD), Xs - T * 2.2, Ys - T * 1.6, T * 4.4, T * 3.2); c.globalCompositeOperation = 'source-over'; c.globalAlpha = 1; }
              for (let i = 0; i < 6; i++) { const a = i / 6 * TAU + X.g.t * 0.2, sp = b.open ? 1.6 : 0.6; c.fillStyle = shade(c, b.open ? CREAM : '#6A3A5C', T, 0, 0, 0.35); c.beginPath(); c.ellipse(Xs + Math.cos(a) * T * sp * 0.55, Ys + Math.sin(a) * T * sp * 0.35, T * 0.7 * (b.open ? 1 : 0.7), T * 0.3, a, 0, TAU); c.fill(); c.strokeStyle = LN; c.lineWidth = 1.4; c.stroke(); }
              c.fillStyle = b.open ? GOLD : '#2F183A'; c.beginPath(); c.ellipse(Xs, Ys, T * 0.5, T * 0.3, 0, 0, TAU); c.fill(); c.strokeStyle = LN; c.stroke();
              c.font = `800 ${Math.round(T * 0.3)}px ${arcFont}`; c.textAlign = 'center'; c.fillStyle = '#FFFFFF'; c.strokeStyle = 'rgba(0,0,0,.6)'; c.lineWidth = 3; c.strokeText(String(b.i + 1), Xs, Ys - T * 0.5); c.fillText(String(b.i + 1), Xs, Ys - T * 0.5); c.restore(); }); };
          riftSealing(X, self, mod, { fall: 'THE ROOT FALLS', sub: 'The sacs dissolve into harmless gold seeds', sigil: 'THE BLOOM SIGIL', name: 'The Garden of Unborn Stars', color: ROSE, wound: { x: X.M.MW / 2, y: 3 } });
          return mod;
        } },
    ],
  });
})();
