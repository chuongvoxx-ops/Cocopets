/* ---------- Rift 3: The Mouth Beneath the Dunes (level 30, Earth and Wind, the Echo Sigil) ----------
   A desert swallowed by the fossilised jaw of something impossibly large. Six stages: the Buried Road (resonators
   reveal the buried stepping stones), Khess the Jawless, the Fossil Lock (rotate three ribs so a crossbar slides
   through their notches), Orryx the Listening Shell, the Burrow Hunt (secure three pylons while the sand hunts you),
   Ultharak the Sand Kraken, then the sealing. Original creatures: a burrowing cosmic brood and a sand kraken. */
(() => {
  const TAU = Math.PI * 2;
  /* ---- the land: ochre dunes, black basalt, bleached bone, cyan resonance ---- */
  BIOMES.dunes = { name: 'The Mouth Beneath the Dunes', rift: true, tile: 'desert', out: true, dark: 0.05, bg: '#5A1E3A', gap: 'pit', mud: ['#C49652', '#CDA15E'], mudSpot: 'rgba(255,230,180,.22)', ambient: 'sand', accent: '#62BFC9', light: '#FFE9A8',
    floor: ['#E7D9B1', '#E0D0A6', '#ECE0BC'], grout: '#C7B88E', hi: '#F7EFD8', top: '#3A3540', face: '#28252F', faceD: '#1A171F', cliff: '#28252F', deco: '#62BFC9', path: ['#D9B978', '#CFAE6E'],
    props: ['dunerock', 'bones'], hazard: 'sandspout', grade: 'rgba(255,200,120,.08)', fog: '#3A1628', darkRGB: '40,20,30' };
  BIOME_ORDER.push('dunes');
  const OCHRE = '#CDA15E', BASALT = '#28252F', BONE = '#E7D9B1', CYAN = '#62BFC9', INK = '#2B2433', AMBER = '#E8A33A';
  /* ---- the brood ---- */
  Object.assign(MON, {
    skitter: { name: 'Dune skitter', from: 999, hp: 150, spd: 1.6, r: 0.4, dmg: 13, xp: 11, coin: 0.6, color: BONE, bio: ['dunes'], tip: 'Spreads its five legs, then a short swipe all round. Step out of its reach as it spreads.', kit: [] },
    grub: { name: 'Hollow grub', from: 999, hp: 260, spd: 1.4, r: 0.48, dmg: 15, xp: 14, coin: 0.8, color: '#EDE4CF', bio: ['dunes'], tip: 'Burrows along a drawn sand wake and bites where it surfaces. Strike it while it is up.', kit: [] },
    manta: { name: 'Echo manta', from: 999, hp: 90, spd: 1.5, r: 0.36, dmg: 7, xp: 9, coin: 0.6, color: '#1E1A26', bio: ['dunes'], fly: true, tip: 'Projects a circle under you that calls a grub. Hit it while it calls to interrupt.', kit: [] },
    mound: { name: 'Dune mound', from: 999, hp: 400, spd: 0, r: 0.6, dmg: 0, xp: 2, coin: 0, color: OCHRE, bio: ['dunes'], still: true, tip: 'One of three mounds hides the kraken. A resonator tells which.', kit: [] },
    anchor: { name: 'Tentacle anchor', from: 999, hp: 500, spd: 0, r: 0.55, dmg: 0, xp: 4, coin: 0, color: '#4A3A5C', bio: ['dunes'], still: true, tip: 'The exposed anchor of a sweeping tentacle. Break it to weaken the pull.', kit: [] },
  });
  const { LN, lwOf, shade, stroke, spec, MP, NF, EXT } = DunArt;
  const glowAt = (c, x, y, r, col, a) => { c.save(); c.globalCompositeOperation = 'lighter'; c.globalAlpha = a; blitSized(c, glowSprite(col), x - r, y - r, r * 2, r * 2); c.restore(); };
  const limb = (c, x0, y0, x1, y1, w, col) => { c.lineCap = 'round'; c.strokeStyle = LN; c.lineWidth = w + 2.2; c.beginPath(); c.moveTo(x0, y0); c.lineTo(x1, y1); c.stroke(); c.strokeStyle = col; c.lineWidth = w; c.stroke(); };
  Object.assign(MP, {
    /* a flat five-legged star in bone plates with a small amber eye at its centre; the legs spread before a swipe */
    skitter(c, r, ph, o) {
      const lw = lwOf(r), col = o.color, sp = o.mode === 'block' ? 1.5 : 1 + 0.08 * Math.sin(ph * TAU);
      for (let i = 0; i < 5; i++) { const a = -Math.PI / 2 + i * TAU / 5 + Math.sin(ph * TAU + i) * 0.08; limb(c, Math.cos(a) * r * 0.3, Math.sin(a) * r * 0.2, Math.cos(a) * r * sp, Math.sin(a) * r * sp * 0.7, lw * 1.8, shadeC(col, -0.12)); c.fillStyle = BONE; c.beginPath(); c.moveTo(Math.cos(a) * r * sp, Math.sin(a) * r * sp * 0.7); c.lineTo(Math.cos(a + 0.25) * r * sp * 0.7, Math.sin(a + 0.25) * r * sp * 0.5); c.lineTo(Math.cos(a - 0.25) * r * sp * 0.7, Math.sin(a - 0.25) * r * sp * 0.5); c.closePath(); c.fill(); stroke(c, lw * 0.8); }
      c.beginPath(); c.ellipse(0, 0, r * 0.55, r * 0.4, 0, 0, TAU); c.fillStyle = shade(c, col, r, 0, -r * 0.15, 0.4); c.fill(); stroke(c, lw);
      glowAt(c, 0, -r * 0.05, r * 0.3, AMBER, 0.7); c.fillStyle = AMBER; c.beginPath(); c.arc(0, -r * 0.05, r * 0.16, 0, TAU); c.fill(); c.fillStyle = INK; c.beginPath(); c.arc(r * 0.03, -r * 0.05, r * 0.07, 0, TAU); c.fill();
    },
    /* a thick segmented ivory cylinder with a black three-part mouth; under the sand only its wake shows */
    grub(c, r, ph, o) {
      const lw = lwOf(r), col = o.color, up = o.mode !== 'dug', open = o.mode === 'bite' ? 0.5 : 0.1;
      if (!up) { c.fillStyle = 'rgba(120,90,40,.35)'; c.beginPath(); c.ellipse(0, r * 0.3, r * 1.3, r * 0.5, 0, 0, TAU); c.fill(); c.fillStyle = OCHRE; c.beginPath(); c.ellipse(0, r * 0.2, r * 0.9, r * 0.35, 0, 0, TAU); c.fill(); stroke(c, lw * 0.6); return; }
      for (let i = 3; i >= 0; i--) { const y = r * (0.5 - i * 0.45), w = r * (0.95 - i * 0.08); c.beginPath(); c.ellipse(0, y, w, r * 0.38, 0, 0, TAU); c.fillStyle = shade(c, col, w, -w * 0.3, y - r * 0.2, 0.4); c.fill(); stroke(c, lw); }
      // the mouth: three black petals
      const my = -r * 0.85; c.fillStyle = '#1A171F'; for (let i = 0; i < 3; i++) { const a = -Math.PI / 2 + i * TAU / 3; c.beginPath(); c.moveTo(0, my); c.lineTo(Math.cos(a - 0.5) * r * (0.35 + open * 0.3), my + Math.sin(a - 0.5) * r * (0.3 + open * 0.3)); c.lineTo(Math.cos(a + 0.5) * r * (0.35 + open * 0.3), my + Math.sin(a + 0.5) * r * (0.3 + open * 0.3)); c.closePath(); c.fill(); stroke(c, lw * 0.7); }
      spec(c, -r * 0.4, -r * 0.5, r * 0.25, r * 0.4, 0.4);
    },
    /* a small black triangular ray a metre up with two long cyan whiskers */
    manta(c, r, ph, o) {
      const lw = lwOf(r), bob = Math.sin(ph * TAU) * r * 0.1, fl = Math.sin(ph * TAU * 2) * 0.25;
      c.fillStyle = 'rgba(0,0,0,.2)'; c.beginPath(); c.ellipse(0, r * 1.1, r * 0.9, r * 0.3, 0, 0, TAU); c.fill();
      c.save(); c.translate(0, bob); c.beginPath(); c.moveTo(0, -r * 0.5); c.quadraticCurveTo(r * 1.4, -r * 0.1 - fl * r, r * 1.5, r * 0.4 - fl * r); c.quadraticCurveTo(r * 0.4, r * 0.3, 0, r * 0.75); c.quadraticCurveTo(-r * 0.4, r * 0.3, -r * 1.5, r * 0.4 - fl * r); c.quadraticCurveTo(-r * 1.4, -r * 0.1 - fl * r, 0, -r * 0.5); c.closePath(); c.fillStyle = shade(c, o.color, r, 0, -r * 0.2, 0.5); c.fill(); stroke(c, lw);
      c.strokeStyle = CYAN; c.lineWidth = lw * 0.7; [-1, 1].forEach(sd => { c.beginPath(); c.moveTo(sd * r * 0.3, -r * 0.3); c.quadraticCurveTo(sd * r * 0.9, -r * 1.3, sd * r * 1.4, -r * 1.6 + Math.sin(ph * TAU + sd) * r * 0.15); c.stroke(); });
      if (o.mode === 'block') glowAt(c, 0, 0, r * 1.2, CYAN, 0.6); c.fillStyle = CYAN; c.beginPath(); c.ellipse(0, -r * 0.05, r * 0.18, r * 0.12, 0, 0, TAU); c.fill(); c.restore();
    },
    /* a dune mound: a heap of sand; its echo (an eye, or broken rings) once a resonator has sounded */
    mound(c, r, ph, o) {
      const lw = lwOf(r); c.beginPath(); c.moveTo(-r * 1.4, r * 0.5); c.quadraticCurveTo(-r * 0.6, -r * 0.9, 0, -r * 0.95); c.quadraticCurveTo(r * 0.6, -r * 0.9, r * 1.4, r * 0.5); c.closePath(); c.fillStyle = shade(c, OCHRE, r, 0, -r * 0.3, 0.4); c.fill(); stroke(c, lw);
      if (o.echo === 'eye') { c.strokeStyle = CYAN; c.lineWidth = lw; c.beginPath(); c.ellipse(0, -r * 0.2, r * 0.7, r * 0.35, 0, 0, TAU); c.stroke(); c.beginPath(); c.ellipse(0, -r * 0.2, r * 0.4, r * 0.2, 0, 0, TAU); c.stroke(); c.fillStyle = CYAN; c.beginPath(); c.arc(0, -r * 0.2, r * 0.1, 0, TAU); c.fill(); }
      else if (o.echo === 'broken') { c.strokeStyle = CYAN; c.lineWidth = lw; for (let i = 0; i < 3; i++) { c.beginPath(); c.arc(0, -r * 0.2, r * (0.3 + i * 0.22), i * 1.1, i * 1.1 + 1.6); c.stroke(); c.beginPath(); c.arc(0, -r * 0.2, r * (0.3 + i * 0.22), i * 1.1 + 2.6, i * 1.1 + 3.9); c.stroke(); } }
    },
    /* the anchor of a tentacle: a knot of violet flesh with three ivory discs, driven into the rock */
    anchor(c, r, ph, o) {
      const lw = lwOf(r), col = o.color; c.beginPath(); c.ellipse(0, r * 0.1, r * 1.1, r * 0.8, 0, 0, TAU); c.fillStyle = shade(c, col, r, -r * 0.2, -r * 0.3, 0.4); c.fill(); stroke(c, lw);
      [[-0.5, -0.2], [0.2, -0.4], [0.5, 0.3]].forEach(([x, y]) => { c.fillStyle = BONE; c.beginPath(); c.ellipse(x * r, y * r, r * 0.26, r * 0.2, 0, 0, TAU); c.fill(); stroke(c, lw * 0.7); c.fillStyle = shadeC(col, -0.3); c.beginPath(); c.ellipse(x * r, y * r, r * 0.1, r * 0.08, 0, 0, TAU); c.fill(); });
      c.strokeStyle = LN; c.lineWidth = lw * 2; c.beginPath(); c.moveTo(0, -r * 0.6); c.quadraticCurveTo(-r * 0.5, -r * 1.3, -r * 0.3, -r * 2.0); c.stroke(); c.strokeStyle = col; c.lineWidth = lw * 1.2; c.stroke();
    },
  });
  Object.assign(EXT, { skitter: 2.0, grub: 1.8, manta: 2.2, mound: 1.8, anchor: 2.4 });
  Object.assign(NF, { skitter: 6, grub: 4, manta: 6, mound: 2, anchor: 2 });
  const { mon, keepRange } = DunAI;
  Object.assign(mon, {
    skitter(m, A, X) {
      // scuttles in; spreads its legs for a moment (they show it), then a swipe all round
      if (m.spread > 0) { m.spread -= A.dt; m.mode = 'block'; if (m.spread <= 0) { m.mode = null; X.ring(m.x, m.y, 0.3, 1.5, 0.25, BONE, 0.4); if (A.d < 1.5 + X.me.r) X.hurtPet(m.dmg * 1.3, m); m.cd = 2 + Math.random(); } return; }
      if (A.d > 1.1) { X.moveEnt(m, A.ux * A.sp * A.dt, A.uy * A.sp * A.dt); m.face = A.dx >= 0 ? 1 : -1; }
      else if (m.cd <= 0) { m.spread = 0.6; X.warn({ x: m.x, y: m.y, r: 1.5, life: 0.6, max: 0.6, src: m, color: BONE }); }
    },
    grub(m, A, X) {
      // under the sand it cannot be struck; it draws a wake toward you, surfaces close by, bites, stays up a while
      m.guardFn = m.guardFn || (q => (q.mode === 'dug' ? 0 : 1));
      if (m.mode == null) { m.mode = 'dug'; m.upT = 0; }
      if (m.mode === 'dug') { if (A.d > 1.3) { X.moveEnt(m, A.ux * A.sp * 1.2 * A.dt, A.uy * A.sp * 1.2 * A.dt); if (Math.random() < 0.5) X.part({ kind: 'smoke', x: m.x + (Math.random() - 0.5) * 0.6, y: m.y + 0.2, vx: 0, vy: -0.4, life: 0.5, max: 0.5, size: 7, color: OCHRE }); }
        else if (m.cd <= 0) { m.mode = 'rise'; m.riseT = 0.5; X.warn({ x: m.x, y: m.y, r: 1.3, life: 0.5, max: 0.5, src: m, color: OCHRE }); } return; }
      if (m.mode === 'rise') { m.riseT -= A.dt; if (m.riseT <= 0) { m.mode = 'bite'; m.upT = 0; X.sparks(m.x, m.y, OCHRE, 12, 5); if (A.d < 1.3 + X.me.r) X.hurtPet(m.dmg * 1.4, m); X.sfx.thud(); } return; }
      // up: slow, biting at reach; after three seconds it digs back down
      m.upT += A.dt; m.face = A.dx >= 0 ? 1 : -1; if (A.d > 1) X.moveEnt(m, A.ux * A.sp * 0.4 * A.dt, A.uy * A.sp * 0.4 * A.dt); else if (m.atkCd <= 0) { m.atkCd = 1.2; X.hurtPet(m.dmg, m); X.slash(m.x + A.ux * 0.5, m.y + A.uy * 0.5, Math.atan2(A.uy, A.ux), 0.8, BONE); }
      m.mode = m.upT > 0.4 && m.upT < 0.7 ? 'bite' : 'up'; if (m.upT > 3.2) { m.mode = 'dug'; m.cd = 1.5; X.part({ kind: 'smoke', x: m.x, y: m.y, vx: 0, vy: -0.5, life: 0.5, max: 0.5, size: 10, color: OCHRE }); }
    },
    manta(m, A, X) {
      // hangs off at range; every so often a circle under you: unless the manta is hit during the call, a grub erupts there
      if (m.call) { m.call.t -= A.dt; m.mode = 'block'; if (m.flash > 0.05 && m.callHit !== m.flash) { m.call = null; m.mode = null; m.cd = 3; X.text(m.x, m.y - m.r - 0.6, 'Interrupted!', '#FFFFFF', 12); return; }
        if (m.call.t <= 0) { const p = m.call; m.call = null; m.mode = null; m.cd = 5 + Math.random() * 2; const q = X.freeSpot(p.x, p.y, 0.4) || p; const gr = X.spawnMon('grub', q.x, q.y, { aggro: true, pack: 530 }); gr.mode = 'rise'; gr.riseT = 0.1; X.g.total++; X.text(p.x, p.y - 1, 'A grub answers', CYAN, 12); } return; }
      keepRange(m, A, X, 3, 5.5);
      if (m.cd <= 0 && A.d < 7 && A.los()) { m.call = { x: X.me.x, y: X.me.y, t: 2.4 }; m.callHit = m.flash; X.warn({ x: m.call.x, y: m.call.y, r: 1.6, life: 2.4, max: 2.4, src: m, color: CYAN }); X.text(m.x, m.y - m.r - 0.6, 'It calls', CYAN, 12); if (X.rift && X.rift.self.mod.onCall) X.rift.self.mod.onCall(m); }
    },
    mound(m, A, X) {}, anchor(m, A, X) {},
  });

  /* ---- the bosses ---- */
  BOSSES.push(
    { id: 'khess', rift: true, name: 'Khess the Jawless', title: 'Boss of the excavation pit', hp: 32000, dmg: 24, r: 1.5, spd: 1.6, color: '#EDE4CF', glow: CYAN, biome: 'dunes', el: 'earth' },
    { id: 'orryx', rift: true, name: 'Orryx the Listening Shell', title: 'Boss of the jaw hinge', hp: 40000, dmg: 23, r: 1.6, spd: 1.1, color: BASALT, glow: CYAN, biome: 'dunes', el: 'wind' },
    { id: 'ultharak', rift: true, name: 'Ultharak the Sand Kraken', title: 'The sand kraken', hp: 80000, dmg: 28, r: 2.2, spd: 0.8, color: '#3A2A4A', glow: CYAN, biome: 'dunes', el: 'earth' });
  const PT = DunBoss.parts;
  Object.assign(DunBoss.P, {
    /* a six-metre worm of five overlapping ivory plates with a blunt black head: a three-petal slit for a mouth, two tall
       horn plates beside it, a cyan seam down its belly; half of it rides above the sand */
    khess(c, m, r, t, me, lw) {
      const col = m.bk.color, dir = m.face || 1, under = m.under, bend = m.act === 'lance' && m.step === 1 ? 0.5 : 0;
      if (under) { c.fillStyle = 'rgba(120,90,40,.3)'; c.beginPath(); c.ellipse(0, r * 0.5, r * 2.2, r * 0.7, 0, 0, TAU); c.fill(); c.fillStyle = OCHRE; c.beginPath(); c.ellipse(0, r * 0.4, r * 1.6, r * 0.5, 0, 0, TAU); c.fill(); c.strokeStyle = LN; c.lineWidth = lw * 0.7; c.stroke(); return; }
      c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, r * 0.9, r * 2.4, r * 0.6, 0, 0, TAU); c.fill();
      for (let i = 4; i >= 0; i--) { const x = -dir * r * (i * 0.55 - 0.3), y = r * (0.3 + Math.abs(i - 1.5) * 0.12) + Math.sin(t * 3 + i) * r * 0.04, w = r * (0.9 - i * 0.1); c.beginPath(); c.ellipse(x, y, w, w * 0.8, 0, 0, TAU); c.fillStyle = shade(c, col, w, -w * 0.3, y - w * 0.3, 0.4); c.fill(); c.strokeStyle = LN; c.lineWidth = lw; c.stroke(); c.strokeStyle = CYAN; c.lineWidth = lw * 0.8; c.beginPath(); c.moveTo(x - w * 0.5, y + w * 0.45); c.lineTo(x + w * 0.5, y + w * 0.45); c.stroke(); }
      // the head: blunt, black, bending sideways before a charge
      c.save(); c.translate(dir * r * 1.2, -r * 0.1); c.rotate(dir * bend);
      c.beginPath(); c.ellipse(0, 0, r * 0.75, r * 0.65, 0, 0, TAU); c.fillStyle = shade(c, BASALT, r, -r * 0.2, -r * 0.3, 0.4); c.fill(); c.strokeStyle = LN; c.lineWidth = lw; c.stroke();
      const open = m.act === 'lance' && m.step === 2 ? 0.5 : 0.15; c.fillStyle = m.exposed > 0 ? CYAN : '#0D0A12'; for (let i = 0; i < 3; i++) { const a = i * TAU / 3 + t * 0.5; c.beginPath(); c.moveTo(dir * r * 0.3, 0); c.lineTo(dir * r * 0.3 + Math.cos(a - 0.5) * r * (0.25 + open * 0.4), Math.sin(a - 0.5) * r * (0.25 + open * 0.4)); c.lineTo(dir * r * 0.3 + Math.cos(a + 0.5) * r * (0.25 + open * 0.4), Math.sin(a + 0.5) * r * (0.25 + open * 0.4)); c.closePath(); c.fill(); c.strokeStyle = LN; c.lineWidth = lw * 0.6; c.stroke(); }
      [-1, 1].forEach(sd => { c.beginPath(); c.moveTo(-dir * r * 0.2, sd * r * 0.4); c.lineTo(-dir * r * 0.6, sd * r * 1.3); c.lineTo(dir * r * 0.1, sd * r * 0.6); c.closePath(); c.fillStyle = BONE; c.fill(); c.strokeStyle = LN; c.lineWidth = lw; c.stroke(); });
      c.restore();
    },
    /* a huge nautilus on three short tentacles: a chunky black spiral shell with five bone ridges, a pale drum membrane
       where a face would be, four thin feelers on the ground; the ridges light to say which resonator opens it */
    orryx(c, m, r, t, me, lw) {
      const dir = m.face || 1, locked = m.locked, lit = m.ridges || 0, rip = Math.sin(t * 9) * 0.04;
      [[-0.8, 0.8], [0, 0.95], [0.8, 0.8]].forEach(([x, y], i) => PT.limb(c, x * r * 0.4, r * 0.3, x * r + Math.sin(t * 2 + i) * r * 0.06, y * r, r * 0.26, r * 0.18, '#3A3540', { lw }));
      c.strokeStyle = LN; c.lineWidth = lw * 0.8; [-1.3, -0.5, 0.5, 1.3].forEach(x => { c.beginPath(); c.moveTo(x * r * 0.5, r * 0.5); c.quadraticCurveTo(x * r * 0.9, r * 0.9, x * r * 1.3, r * 1.0 + Math.sin(t * 3 + x) * r * 0.05); c.stroke(); });
      c.save(); c.translate(-dir * r * 0.2, -r * 0.2);
      c.beginPath(); c.arc(0, 0, r * 1.05, 0, TAU); c.fillStyle = shade(c, m.bk.color, r, -r * 0.3, -r * 0.4, 0.4); c.fill(); c.strokeStyle = LN; c.lineWidth = lw * 1.2; c.stroke();
      c.strokeStyle = BONE; c.lineWidth = lw * 1.1; c.beginPath(); for (let a = 0; a < TAU * 2.2; a += 0.15) { const rr = r * 0.12 * Math.exp(a * 0.33); const x = Math.cos(a) * rr, y = Math.sin(a) * rr; a ? c.lineTo(x, y) : c.moveTo(x, y); } c.stroke();
      for (let i = 0; i < 5; i++) { const a = -2.6 + i * 0.75, on = i < lit && locked; if (on) PT.glow(c, Math.cos(a) * r * 0.85, Math.sin(a) * r * 0.85, r * 0.3, CYAN, 0.8); c.strokeStyle = on ? CYAN : BONE; c.lineWidth = lw * (on ? 2 : 1.3); c.beginPath(); c.moveTo(Math.cos(a) * r * 0.6, Math.sin(a) * r * 0.6); c.lineTo(Math.cos(a) * r * 1.05, Math.sin(a) * r * 1.05); c.stroke(); }
      c.restore();
      // the membrane: a drum across the opening, or the shell lid over it
      c.save(); c.translate(dir * r * 0.75, -r * 0.1); c.beginPath(); c.ellipse(0, 0, r * 0.5, r * 0.6 * (1 + rip), 0, 0, TAU); c.fillStyle = locked ? BASALT : '#EFE6D6'; c.fill(); c.strokeStyle = LN; c.lineWidth = lw; c.stroke();
      if (!locked) { c.strokeStyle = 'rgba(40,37,47,.35)'; c.lineWidth = lw * 0.7; for (let i = 1; i < 4; i++) { c.beginPath(); c.ellipse(0, 0, r * 0.5 * i / 4, r * 0.6 * i / 4 * (1 + rip * 2), 0, 0, TAU); c.stroke(); } } else { c.strokeStyle = BONE; c.lineWidth = lw; c.beginPath(); c.moveTo(-r * 0.3, -r * 0.3); c.lineTo(r * 0.3, r * 0.3); c.moveTo(r * 0.3, -r * 0.3); c.lineTo(-r * 0.3, r * 0.3); c.stroke(); }
      c.restore();
    },
    /* a buried octopus: a broad triangular charcoal-violet mantle with ochre plates up its ridge, three cyan eyes down
       its forehead, two supporting tentacles and four that attack, each jointed four times, ending in a flat shovel tip,
       three ivory discs along it */
    ultharak(c, m, r, t, me, lw) {
      const col = m.bk.color; if (m.under) { c.fillStyle = 'rgba(120,90,40,.25)'; c.beginPath(); c.ellipse(0, r * 0.4, r * 1.6, r * 0.5, 0, 0, TAU); c.fill(); return; }
      const tent = (a, len, k) => { const pts = [[Math.cos(a) * r * 0.9, r * 0.5 + Math.sin(a) * r * 0.3]]; let x = pts[0][0], y = pts[0][1]; for (let j = 1; j <= 4; j++) { const q = a + Math.sin(t * 1.5 + j + a) * 0.35 * k; x += Math.cos(q) * len * r * 0.3; y += Math.sin(q) * len * r * 0.18; pts.push([x, y]); }
        for (let j = 0; j < 4; j++) PT.limb(c, pts[j][0], pts[j][1], pts[j + 1][0], pts[j + 1][1], r * (0.3 - j * 0.05), r * (0.25 - j * 0.05), shadeC(col, -0.1), { lw });
        const e = pts[4], q = Math.atan2(e[1] - pts[3][1], e[0] - pts[3][0]); c.save(); c.translate(e[0], e[1]); c.rotate(q); PT.plate(c, r * 0.1, 0, r * 0.5, r * 0.3, r * 0.06, '#5A4A6C', { lw }); c.restore();
        for (let j = 1; j <= 3; j++) { c.fillStyle = BONE; c.beginPath(); c.ellipse(pts[j][0], pts[j][1] + r * 0.1, r * 0.1, r * 0.07, 0, 0, TAU); c.fill(); } };
      [2.3, 0.85].forEach(a => tent(a, 1.2, 0.3)); [2.9, 3.5, -0.3, 0.25].forEach((a, i) => tent(a, 1.5, 1));
      // the mantle
      c.beginPath(); c.moveTo(-r * 1.3, r * 0.5); c.quadraticCurveTo(-r * 0.9, -r * 0.6, 0, -r * 2.0); c.quadraticCurveTo(r * 0.9, -r * 0.6, r * 1.3, r * 0.5); c.quadraticCurveTo(0, r * 0.9, -r * 1.3, r * 0.5); c.closePath(); c.fillStyle = shade(c, col, r * 1.4, -r * 0.3, -r * 0.8, 0.4); c.fill(); c.strokeStyle = LN; c.lineWidth = lw * 1.2; c.stroke();
      for (let i = 0; i < 4; i++) { const y = -r * (1.75 - i * 0.4); PT.plate(c, 0, y, r * (0.35 + i * 0.2), r * 0.16, r * 0.04, OCHRE, { lw }); }
      [-1.3, -0.85, -0.4].forEach((y, i) => { PT.glow(c, 0, y * r, r * 0.25, CYAN, 0.6); PT.eye(c, 0, y * r, r * (0.11 + i * 0.02), { sclera: '#DFFFF8', iris: CYAN, lookX: me.x > m.x ? 1 : -1, lookY: 0, glow: CYAN }); });
      if (m.vuln > 0) PT.glow(c, 0, -r * 0.3, r * 1.3, CYAN, 0.35);
    },
  });
  Object.assign(DunBoss.REACH, { khess: 4.0, orryx: 3.8, ultharak: 5.0 });

  /* ---- how they fight ---- */
  const pick = (m, X, list) => { if (m.cd > 0) return; m.act = list[Math.floor(Math.random() * list.length)]; m.actT = 0; m.step = 0; };
  const done = (m, cd) => { m.act = 'move'; m.cd = cd * (m.phase === 3 ? 0.7 : 1); m.actT = 0; m.step = 0; };
  Object.assign(DunAI.boss, {
    khess(m, A, X, B) {
      const RT = X.rift && X.rift.self.mod;
      m.guardFn = m.guardFn || (q => (q.under ? 0 : q.exposed > 0 ? 1.8 : 1));
      if (m.exposed > 0) m.exposed -= A.dt;
      if (m.act === 'move') { A.walk(B.spd * (A.d > 2.8 ? 1 : 0.3)); m.face = A.dx >= 0 ? 1 : -1; return pick(m, X, m.phase >= 2 ? ['lance', 'cry', 'lance2', 'lance'] : ['lance', 'cry', 'lance']); }
      const T = m.actT;
      switch (m.act) {
        case 'lance': case 'lance2': {   // Sand Lance: the head bends, a lane is marked, then the charge; its flank is open as it recovers
          const n = m.act === 'lance2' ? 2 : 1;
          if (m.step === 0) { m.step = 1; m.la = Math.atan2(X.me.y - m.y, X.me.x - m.x); m.face = Math.cos(m.la) >= 0 ? 1 : -1; m.lx = m.x; m.ly = m.y; X.warn({ shape: 'line', x: m.x, y: m.y, a: m.la, len: 10, w: 1.6, life: 1.3, max: 1.3, src: m, color: BONE }); X.say(m, 'Sssk.'); }
          if (T > 1.3 && m.step === 1) { m.step = 2; m.lt = 0; m.lhit = false; }
          if (m.step === 2) { m.lt += A.dt; X.moveEnt(m, Math.cos(m.la) * 13 * A.dt, Math.sin(m.la) * 13 * A.dt); if (!m.lhit && A.d < m.r + X.me.r + 0.3) { m.lhit = true; X.hurtPet(m.dmg * 1.6, m); X.push(m.la, 2); } for (let i = 0; i < 2; i++) X.part({ kind: 'smoke', x: m.x - Math.cos(m.la) * m.r, y: m.y + 0.3, vx: 0, vy: -0.5, life: 0.5, max: 0.5, size: 10, color: OCHRE });
            if (m.lt > 0.75) { if (n === 2 && !m.second) { m.second = true; m.step = 0; m.x = m.lx; m.y = m.ly; X.unstick(m); X.sparks(m.x, m.y, OCHRE, 14, 5); X.text(m.x, m.y - m.r - 1, 'It resurfaces', CYAN, 12); } else { m.second = false; m.step = 3; m.exposed = 2.5; X.text(m.x, m.y - m.r - 1, 'Flank open!', CYAN, 13); } } }
          if (m.step === 3 && T > 1.3 + 0.75 + 2.5) done(m, 1.2); break; }
        case 'cry': {   // Resonant Cry: it burrows; strike the tuning fork as its ring reaches the worm to force it up early
          if (m.step === 0) { m.step = 1; m.under = true; m.cryT = 0; X.say(m, 'Hrrrrr.'); X.ring(m.x, m.y, 0.3, 3, 0.5, CYAN, 0.4); if (RT && RT.onCry) RT.onCry(m); }
          m.cryT += A.dt; if (m.under) { if (A.d > 0.8) X.moveEnt(m, A.ux * B.spd * 0.9 * A.dt, A.uy * B.spd * 0.9 * A.dt, 1); if (Math.random() < 0.6) X.part({ kind: 'smoke', x: m.x + (Math.random() - 0.5) * 1.2, y: m.y + 0.3, vx: 0, vy: -0.4, life: 0.5, max: 0.5, size: 9, color: OCHRE }); }
          if (m.forced && m.step === 1) { m.step = 2; m.under = false; m.forced = false; m.exposed = 2; m.cd = 0; X.sparks(m.x, m.y, CYAN, 20, 6); X.text(m.x, m.y - m.r - 1, 'Forced up: 2 seconds', CYAN, 13); X.after(2.2, () => { if (!m.dead) done(m, 1.2); }); }
          else if (m.step === 1 && m.cryT > 6) { m.step = 2; m.under = false; X.slam(m.x, m.y, 2.6, m.dmg * 1.8, OCHRE, m); X.shake(12, 0.4); X.after(0.6, () => { if (!m.dead) done(m, 1.2); }); }
          break; }
        default: done(m, 1);
      }
    },
    orryx(m, A, X, B) {
      const RT = X.rift && X.rift.self.mod;
      m.guardFn = m.guardFn || (q => (q.locked ? 0.12 : 1));
      if (m.openT > 0) { m.openT -= A.dt; if (m.openT <= 0) { m.locked = true; m.ridges = 1 + Math.floor(Math.random() * 4); X.say(m, 'Shut.'); } }
      // where you last moved: the stance aims there
      if (Math.abs(X.me.vx || 0) + Math.abs(X.me.vy || 0) > 0.3) { m.heard = { x: X.me.x, y: X.me.y }; }
      if (m.act === 'move') { if (m.locked == null) { m.locked = true; m.ridges = 1 + Math.floor(Math.random() * 4); } A.walk(B.spd * (A.d > 3.2 ? 1 : 0)); m.face = A.dx >= 0 ? 1 : -1;
        if (m.phase >= 2 && !m.summoned && m.cd <= 0) { m.summoned = true; m.act = 'signal'; m.actT = 0; m.step = 0; return; }
        return pick(m, X, ['listen', 'listen', 'stamp']); }
      const T = m.actT;
      switch (m.act) {
        case 'listen': {   // Listening Stance: a cone toward where you were last moving; stop, or bait it to an edge
          if (m.step === 0) { m.step = 1; X.say(m, '...'); m.hx = (m.heard || X.me).x; m.hy = (m.heard || X.me).y; }
          if (T > 1.2 && m.step === 1) { m.step = 2; const h = m.heard || { x: m.hx, y: m.hy }; m.ca = Math.atan2(h.y - m.y, h.x - m.x); m.face = Math.cos(m.ca) >= 0 ? 1 : -1; X.warn({ shape: 'cone', x: m.x, y: m.y, a: m.ca, len: 9, spread: 0.36, life: 0.9, max: 0.9, src: m, color: CYAN, follow: m, fn: () => { if (X.inCone(m.x, m.y, m.ca, 9, 0.36)) X.hurtPet(m.dmg * 1.7, m); X.beamFx(m.x, m.y, m.ca, 9, CYAN); X.shake(8, 0.3); } }); }
          if (T > 2.4) done(m, 1.4); break; }
        case 'stamp': { if (m.step === 0) { m.step = 1; X.warn({ x: m.x, y: m.y, r: 2.6, life: 1.1, max: 1.1, src: m, follow: m, color: BONE, fn: () => { X.slam(m.x, m.y, 2.6, m.dmg * 1.4, BONE, m); } }); } if (T > 1.5) done(m, 1.4); break; }
        case 'signal': { if (m.step === 0) { m.step = 1; X.say(m, 'Two voices.'); if (RT && RT.competingSignal) RT.competingSignal(m); } if (T > 0.8) done(m, 1.2); break; }
        default: done(m, 1);
      }
    },
    ultharak(m, A, X, B) {
      const RT = X.rift && X.rift.self.mod, f = m.hp / m.maxhp;
      m.guardFn = m.guardFn || (q => (q.under ? 0 : q.vuln > 0 ? 1.8 : 1));
      if (m.vuln > 0) m.vuln -= A.dt;
      if (RT && RT.bossTick) RT.bossTick(m, A.dt);
      if (m.act === 'move') { m.face = A.dx >= 0 ? 1 : -1; if (f > 0.7) return pick(m, X, ['lash', 'lash', 'slap']); if (f > 0.35) return pick(m, X, ['mounds', 'lash', 'slap']); return pick(m, X, ['spiral', 'lash', 'spiral', 'slap']); }
      const T = m.actT;
      switch (m.act) {
        case 'lash': {   // Dune Lash: two strips in sequence, then the body is open
          if (m.step === 0) { m.step = 1; const a = Math.atan2(X.me.y - m.y, X.me.x - m.x); [0, 1].forEach(i => { const q = a + (i ? 0.7 : -0.5), x0 = m.x + Math.cos(q) * 2, y0 = m.y + Math.sin(q) * 2; X.after(i * 1.1, () => { if (m.dead) return; X.warn({ shape: 'line', x: x0, y: y0, a: q, len: 12, w: 2.2, life: 1.3, max: 1.3, src: m, color: '#6A4A8A', fn: () => { if (X.inLine(x0, y0, q, 12, 2.2)) X.hurtPet(m.dmg * 1.5, m); X.beamFx(x0, y0, q, 12, '#8A6AAA'); X.shake(12, 0.4); X.sfx.crash(); } }); }); }); X.say(m, 'Thoom.'); }
          if (T > 2.6 && m.step === 1) { m.step = 2; m.vuln = 3; X.text(m.x, m.y - m.r - 1.5, 'The mantle is open!', CYAN, 13); }
          if (T > 5.6) done(m, 1.2); break; }
        case 'slap': { if (m.step === 0) { m.step = 1; X.warn({ x: X.me.x, y: X.me.y, r: 2.0, life: 1.0, max: 1.0, src: m, color: '#6A4A8A', fn: (z) => { X.slam(z.x, z.y, 2.0, m.dmg * 1.3, '#6A4A8A', m); } }); } if (T > 1.4) done(m, 1.0); break; }
        case 'mounds': {   // it vanishes under three mounds; a resonator shows the true one; break it before the eruption
          if (m.step === 0) { m.step = 1; if (RT && RT.mounds) RT.mounds(m); X.say(m, 'Find me.'); }
          if (RT && !RT.moundsBusy()) done(m, 1.2); break; }
        case 'spiral': {   // Quicksand Spiral: the pull toward the mouth; tentacles sweep two islands; break the anchor on the free one
          if (m.step === 0) { m.step = 1; if (RT && RT.spiral) RT.spiral(m); X.say(m, 'Down.'); }
          if (RT && !RT.spiralBusy()) done(m, 1.4); break; }
        default: done(m, 1);
      }
    },
  });

  /* ---- the desert's objects: resonators (tuning forks), levers, pylons ---- */
  const forkDraw = (c, Xs, Ys, T, o) => { const h = T * 1.3, bands = o.bands || 0, k = o.ringT > 0 ? 1 : 0; c.save(); c.translate(Xs, Ys); c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, T * 0.15, T * 0.45, T * 0.18, 0, 0, TAU); c.fill();
    c.strokeStyle = LN; c.lineWidth = T * 0.22; c.lineCap = 'round'; c.beginPath(); c.moveTo(0, T * 0.05); c.lineTo(0, -h * 0.4); c.moveTo(-T * 0.22, -h * 0.4); c.lineTo(-T * 0.22, -h); c.moveTo(T * 0.22, -h * 0.4); c.lineTo(T * 0.22, -h); c.stroke(); c.strokeStyle = BASALT; c.lineWidth = T * 0.14; c.stroke();
    for (let i = 0; i < Math.max(1, bands); i++) { c.strokeStyle = o.on || k ? CYAN : '#3F8A92'; c.lineWidth = T * 0.06; c.beginPath(); c.moveTo(-T * 0.3, -h * (0.5 + i * 0.13)); c.lineTo(-T * 0.14, -h * (0.5 + i * 0.13)); c.moveTo(T * 0.14, -h * (0.5 + i * 0.13)); c.lineTo(T * 0.3, -h * (0.5 + i * 0.13)); c.stroke(); }
    if (o.on || k) glowAt(c, 0, -h * 0.7, T * 0.8, CYAN, 0.5); c.restore(); };
  const mkFork = (H, p, o) => H.obj(Object.assign({ x: p.x, y: p.y, kind: 'fork', on: false, bands: 1, ringT: 0, ringR: 0, h: 1.6, draw: forkDraw }, o));
  const leverDraw = (c, Xs, Ys, T, o) => { c.save(); c.translate(Xs, Ys); c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, T * 0.12, T * 0.4, T * 0.16, 0, 0, TAU); c.fill(); c.fillStyle = '#6A6660'; c.strokeStyle = LN; c.lineWidth = 2; GFX.rr(c, -T * 0.35, -T * 0.2, T * 0.7, T * 0.3, 4); c.fill(); c.stroke(); c.strokeStyle = LN; c.lineWidth = T * 0.14; c.lineCap = 'round'; c.beginPath(); c.moveTo(0, -T * 0.05); c.lineTo(Math.cos(-1.2 + (o.pos || 0) * 0.5) * T * 0.6, -T * 0.05 + Math.sin(-1.2 + (o.pos || 0) * 0.5) * T * 0.6); c.stroke(); c.strokeStyle = o.locked ? '#8A3A4A' : BONE; c.lineWidth = T * 0.08; c.stroke(); c.restore(); };
  const PACK = { a: { mons: ['skitter', 'skitter', 'skitter', 'manta'] }, b: { mons: ['grub'] }, c: { mons: ['manta', 'skitter', 'skitter'] }, d: { mons: ['grub', 'grub', 'skitter', 'skitter', 'skitter'] }, e: { mons: ['grub', 'grub'] }, k: { mons: ['skitter', 'skitter', 'skitter'] }, n: { mons: ['manta'] } };
  const soft = (X, x, y) => X.tileAt(Math.floor(x), Math.floor(y)) === T_MUD;
  const ringDraw = (c, X, x, y, rr, col, a) => { const T = X.Tz(); c.save(); c.globalAlpha = a; c.strokeStyle = col; c.lineWidth = 3; c.beginPath(); c.ellipse(X.sx(x), X.sy(y), rr * T, rr * T * 0.6, 0, 0, TAU); c.stroke(); c.restore(); };

  defRift({
    id: 'dunes', n: 3, name: 'The Mouth Beneath the Dunes', lvl: 30, sigil: 'Echo', biome: 'dunes', aff: ['earth', 'wind'], region: 'the desert',
    blurb: 'A desert swallowed by a fossil jaw. Sound the resonators and read what the sand sends back.', gate: { anima: 'scorpio', name: 'The Amber Vigil' },
    stages: [
      /* 1. the Buried Road: soft sand between two courtyards; four resonators; the buried stepping stones; false stones */
      { kind: 'section', name: 'The Buried Road', goal: 'Sound each resonator and follow the stones it reveals',
        layout: [
          '##################################',
          '#S.......rssssssssssssssss...x...#',
          '#........ooooossssssfsssss...x...#',
          '#...a....ssssosssssssbssss...x...#',
          '#........ssssosssfssssssss...x...#',
          '#........ssssooooorsssssoo.r.x.E.#',
          '#........sssssssssossfssos...x...#',
          '#........ssbfsssssosssssos.c.x...#',
          '#........ssssssfssoooooors...x...#',
          '#........sssssssssssssssss...x...#',
          '##################################'],
        legend: Object.assign({ s: { tile: T_MUD }, o: { tile: T_MUD }, f: { tile: T_MUD }, r: {}, x: { tile: T_SOLID }, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, stones = (marks.o || []).map(p => ({ x: p.x, y: p.y, tx: p.tx, ty: p.ty, seen: false, real: true })).concat((marks.f || []).map(p => ({ x: p.x, y: p.y, tx: p.tx, ty: p.ty, seen: false, real: false })));
          const forks = marks.r.map((p, i) => mkFork(H, p, { i, bands: i + 1, label: o => (o.on ? '' : `Resonator ${i + 1}: sound it`), use(o) { if (o.on) return; o.on = true; o.ringT = 3; o.ringR = 0; X.sfx.hum(); X.ring(o.x, o.y, 0.3, 9, 1.2, CYAN, 0.4);
            let n = 0; for (const s of stones) if (!s.seen && Math.hypot(s.x - o.x, s.y - o.y) < 9.5) { s.seen = true; n++; } X.text(o.x, o.y - 1.7, n ? `${n} echoes return` : 'Nothing new', CYAN, 13); if (i === forks.length - 1) { gateDue = true; X.banner('THE LAST RESONATOR', 'Defeat its guards: the pit gate lowers', CYAN, 2.2, true); } } }));
          let gateDue = false, lastFork = null, sandT = 0, ambushes = 0;
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, "Khess's pit");
          X.after(2.4, () => X.banner('THE BURIED ROAD', 'Soft sand swallows a careless step. Sound the resonators', CYAN, 2.8, true, true));
          return { stones, forks,
            update(dt) {
              for (const o of forks) { if (o.ringT > 0) { o.ringT -= dt; o.ringR += 4 * dt; } if (o.on && Math.hypot(me.x - o.x, me.y - o.y) < 2) lastFork = o; }
              // on soft sand off the stones: a moment, then an ambush and back to the last resonator
              const onStone = stones.some(s => s.real && Math.floor(me.x) === s.tx && Math.floor(me.y) === s.ty) || forks.some(o => Math.hypot(me.x - o.x, me.y - o.y) < 1.5);   // (the ground round a resonator is firm)
              if (soft(X, me.x, me.y) && !onStone && !me.dead) { sandT += dt; if (sandT > 0.9) { sandT = 0; ambushes++; X.banner('THE SAND SHIFTS', 'A false step: back to the last resonator', '#FF9BD2', 1.8, true); X.hurtPet(X.ST().hp * 0.12, null); X.shake(8, 0.4); X.sfx.wrong();
                  const q = X.freeSpot(me.x, me.y, 0.4) || me; for (let i = 0; i < 2; i++) { const s = X.spawnMon('skitter', q.x + (i ? 1 : -1), q.y, { aggro: true, pack: 531 }); X.g.total++; } const back = lastFork || { x: X.M.start.x, y: X.M.start.y }; me.x = back.x; me.y = back.y + 0.8; X.sparks(me.x, me.y, OCHRE, 12, 5); } }
              else sandT = Math.max(0, sandT - dt * 2);
              if (gateDue && !self.done && H.monstersLeft() === 0) { self.done = true; (marks.x || []).forEach(p => X.setTile(p.tx, p.ty, T_FLOOR)); X.retile(); X.banner('THE PIT GATE LOWERS', 'Down the ramp to Khess', '#8FE0A6', 2.4, true); X.flash(0.3, CYAN); X.sfx.fanfare(); }
            },
            goal() { const on = forks.filter(o => o.on).length; return self.done ? 'Drop into the pit' : gateDue ? `${H.monstersLeft()} guards left` : `Resonators ${on}/4 · follow the revealed stones`; },
            drawGround(c) { const T = X.Tz();
              for (const s of stones) { if (!s.seen) continue; const Xs = X.sx(s.x), Ys = X.sy(s.y); c.save(); if (s.real) { c.fillStyle = 'rgba(98,191,201,.35)'; c.strokeStyle = CYAN; c.lineWidth = 2; GFX.rr(c, Xs - T * 0.38, Ys - T * 0.3, T * 0.76, T * 0.6, 3); c.fill(); c.stroke(); }
                else { c.strokeStyle = 'rgba(98,191,201,.7)'; c.lineWidth = 2; c.setLineDash([3, 3]); GFX.rr(c, Xs - T * 0.38, Ys - T * 0.3, T * 0.76, T * 0.6, 3); c.stroke(); c.setLineDash([]); c.beginPath(); c.moveTo(Xs - T * 0.25, Ys - T * 0.25); c.lineTo(Xs - T * 0.05, Ys); c.lineTo(Xs - T * 0.15, Ys + T * 0.1); c.lineTo(Xs + T * 0.2, Ys + T * 0.28); c.stroke(); } c.restore(); }
              for (const o of forks) if (o.ringT > 0) ringDraw(c, X, o.x, o.y, o.ringR, CYAN, Math.min(1, o.ringT));
              if (sandT > 0.2) { c.save(); c.globalAlpha = Math.min(0.6, sandT); c.strokeStyle = '#FF9BD2'; c.lineWidth = 3; c.beginPath(); c.ellipse(X.sx(me.x), X.sy(me.y), T * 0.7, T * 0.4, 0, 0, TAU); c.stroke(); c.restore(); } },
          };
        } },
      /* 2. Khess: the excavation pit, a raised ring of stone, the tuning fork at its edge */
      { kind: 'boss', name: 'The Excavation Pit', boss: 'khess', goal: 'Khess the Jawless',
        layout: [
          '############################',
          '####....................####',
          '###......................###',
          '###......................###',
          '##....F...................##',
          '##........................##',
          '##........................##',
          '##...........B............##',
          '##........................##',
          '##........................##',
          '##........................##',
          '##........................##',
          '###......................###',
          '###..........S...........###',
          '####....................####',
          '############################'],
        legend: { B: {}, F: {} },
        make(X, self, H) {
          const marks = X.M.marks, mod = { cry: null };
          const fork = mkFork(H, marks.F[0], { bands: 3, label: o => (mod.cry ? 'STRIKE as the ring reaches it' : 'The tuning fork'), use(o) { const b = X.boss; if (!b || b.dead || !mod.cry || !b.under) { X.text(o.x, o.y - 1.6, 'It only hums', '#FFFFFF', 12); return; } const d = Math.hypot(b.x - o.x, b.y - o.y); if (Math.abs(mod.cry.r - d) < 1.6) { b.forced = true; mod.cry = null; o.ringT = 0; X.banner('FORCED UP', 'Two seconds: strike the worm', CYAN, 2, true); X.sfx.fanfare(); } else { X.text(o.x, o.y - 1.6, mod.cry.r < d ? 'Too early' : 'Too late', '#FF9BD2', 12); X.sfx.wrong(); o.ringT = 0; mod.cry.r = 0; mod.cry.wait = 1.2; } } });
          mod.onCry = m => { mod.cry = { r: 0, wait: 0 }; fork.ringT = 99; X.banner('RESONANT CRY', 'It burrows. Strike the fork as the ring reaches it', CYAN, 2.2, true); };
          mod.update = dt => { const b = X.boss; if (mod.cry) { if (mod.cry.wait > 0) mod.cry.wait -= dt; else mod.cry.r += 3 * dt; fork.ringR = mod.cry.r; if (mod.cry.r > 16) { mod.cry.r = 0; } if (!b || b.dead || !b.under) { mod.cry = null; fork.ringT = 0; } } };
          mod.goal = () => mod.cry ? 'Khess burrows · strike the fork as its ring reaches the worm' : 'Khess the Jawless · dodge the lance, strike the open flank';
          mod.drawGround = c => { const T = X.Tz(); // the raised ring of stone
            c.save(); c.strokeStyle = 'rgba(40,37,47,.35)'; c.lineWidth = T * 0.5; c.beginPath(); c.ellipse(X.sx(X.M.MW / 2), X.sy(X.M.MH / 2), T * 7.5, T * 5.2, 0, 0, TAU); c.stroke(); c.restore();
            if (mod.cry) ringDraw(c, X, fork.x, fork.y, mod.cry.r, CYAN, 0.9); };
          return mod;
        } },
      /* 3. the Fossil Lock: three ribs on pivot rings over a portcullis; three levers turn them; the relief shows the arch */
      { kind: 'section', name: 'The Fossil Lock', goal: 'Turn the three ribs so their notches line up, then pull the release',
        layout: [
          '####################################',
          '#S..............................xx.#',
          '#...............................xx.#',
          '#.....1.......2.......3.........xx.#',
