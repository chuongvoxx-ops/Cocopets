          '#..............B...............#',
          '#..............................#',
          '#..............................#',
          '#..............................#',
          '#..............................#',
          '#..............S...............#',
          '#R............................R#',
          '################################'],
        legend: { B: {}, R: {} },
        make(X, self, H) {
          const marks = X.M.marks, mod = {};
          const forks = marks.R.map((p, i) => mkFork(H, p, { bands: i + 1, label: o => `Resonator · ${i + 1} band${i ? 's' : ''}`, use(o) { const b = X.boss; if (!b || b.dead) return; o.ringT = 1.5; o.ringR = 0; X.sfx.hum();
            if (X.mons.some(m => !m.dead && m.type === 'manta')) { X.text(o.x, o.y - 1.6, 'The manta\'s signal drowns it', '#FF9BD2', 12); X.sfx.wrong(); return; }
            if (!b.locked) { X.text(o.x, o.y - 1.6, 'The shell is already open', '#FFFFFF', 12); return; }
            if (i + 1 === b.ridges) { b.locked = false; b.openT = 8; b.face = o.x >= b.x ? 1 : -1; X.banner('THE SHELL OPENS', 'Eight seconds on the membrane', CYAN, 2, true); X.sfx.fanfare(); X.ring(b.x, b.y, 0.3, 3, 0.6, CYAN, 0.4); }
            else { X.text(o.x, o.y - 1.6, 'Wrong voice: a pulse', '#FF9BD2', 12); X.sfx.wrong(); X.slam(b.x, b.y, 3.5, b.dmg * 0.5, CYAN, b); } } }));
          mod.competingSignal = m => { const q = X.freeSpot(m.x + 3, m.y, 0.35) || m; X.spawnMon('manta', q.x, q.y, { aggro: true, pack: 533 }); X.g.total++; X.banner('A COMPETING SIGNAL', 'Kill the manta, then sound the right resonator', CYAN, 2.2, true); };
          mod.update = dt => { for (const o of forks) if (o.ringT > 0) { o.ringT -= dt; o.ringR += 5 * dt; } };
          mod.goal = () => { const b = X.boss; return b && b.locked ? `Shell Lock · ${b.ridges} ridge${b.ridges > 1 ? 's' : ''} lit: sound that resonator` : b && b.openT > 0 ? `The shell is open · ${Math.ceil(b.openT)}s` : 'Orryx the Listening Shell · stop moving before its cone'; };
          mod.drawGround = c => { for (const o of forks) if (o.ringT > 0) ringDraw(c, X, o.x, o.y, o.ringR, CYAN, o.ringT); };
          return mod;
        } },
      /* 5. the Burrow Hunt: a sand hollow with three rock islands and their pylons; the sand erupts under anyone who
