          '#sssssssssssssssssssssssssssssss...ssx.#',
          '#ssssssssss.sssssssssssssssssss...k.sx.#',
          '#ssssssss...c.ssssssssssssssss...p...xE#',
          '#ssssssss..p..sssssssssssssssss.....sx.#',
          '#ssssssss.....sssssssssssssssss3...ssx.#',
          '#ssssssss1s.ss22sssssssssssss33ssssssx.#',
          '#sssssss1sssssss22sssssssss33ssssssssss#',
          '#ssssss1ssssssssss22ss.ss33ssssssssssss#',
          '#s...s1sssssssssssss.....ssssssssssssss#',
          '#.....ssssssssssssss..p..ssssssssssssss#',
