          '#...............................xx.#',
          '####################################'],
        legend: Object.assign({ 1: {}, 2: {}, 3: {}, Z: {}, x: { tile: T_SOLID }, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, R = X.R, ribs = [0, 1, 2].map(i => ({ i, pos: Math.floor(R() * 4), target: Math.floor(R() * 4) })); ribs.forEach(r => { if (r.pos === r.target) r.pos = (r.pos + 1 + Math.floor(R() * 3)) % 4; });
          const aligned = () => ribs.every(r => r.pos === r.target); let released = false, extra = false;
          const mantaHolds = () => X.mons.some(m => !m.dead && m.type === 'manta');
          const levers = ribs.map((r, i) => H.obj({ x: marks[String(i + 1)][0].x, y: marks[String(i + 1)][0].y, kind: 'lever', pos: r.pos, locked: false, h: 1.2, label: o => (i === 1 && mantaHolds() ? 'The manta locks this pivot' : `Rib ${i + 1} lever · turn`), draw: leverDraw, use(o) { if (released) return; if (i === 1 && mantaHolds()) { X.text(o.x, o.y - 1, 'A bright tether holds the pivot', CYAN, 12); X.sfx.wrong(); return; } r.pos = (r.pos + 1) % 4; o.pos = r.pos; X.sfx.chirp(); X.text(o.x, o.y - 1, r.pos === r.target ? 'The notch lines up' : 'The rib turns', r.pos === r.target ? CYAN : '#FFFFFF', 12); if (aligned()) { X.banner('THE ARCH IS WHOLE', 'The crossbar can slide: pull the release', CYAN, 2.2, true); X.sfx.fanfare(); } } }));
          H.obj({ x: marks.Z[0].x, y: marks.Z[0].y, kind: 'lever', pos: 0, h: 1.2, label: o => (released ? '' : aligned() ? 'Release lever: pull' : 'Release lever (the notches must align)'), draw: leverDraw, use(o) { if (released) return; if (!aligned()) { X.text(o.x, o.y - 1, 'The crossbar catches on a rib', '#FF9BD2', 12); X.sfx.wrong(); return; } released = true; o.pos = 3; X.banner('THE PORTCULLIS LIFTS', 'Two skitters come from the side alcove', '#8FE0A6', 2.4, true); X.flash(0.3, CYAN); X.sfx.fanfare(); (marks.x || []).forEach(p => X.setTile(p.tx, p.ty, T_FLOOR)); X.retile();
            extra = true; [[-1, 0], [1, 0]].forEach(([dx, dy]) => { const q = X.freeSpot(o.x + dx * 2, o.y - 2 + dy, 0.35) || o; X.spawnMon('skitter', q.x, q.y, { aggro: true, pack: 532 }); X.g.total++; }); } });
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, "Orryx's chamber");
          return { ribs,
            update(dt) { if (released && extra && !self.done && H.monstersLeft() === 0) { self.done = true; X.banner('THE LOCK IS OPEN', 'Into the jaw hinge', '#8FE0A6', 2, true); } },
            goal() { return self.done ? 'Walk through the portcullis' : released ? `${H.monstersLeft()} guards left` : `Ribs aligned ${ribs.filter(r => r.pos === r.target).length}/3${mantaHolds() ? ' · a manta locks the centre pivot' : ''}`; },
            drawGround(c) { const T = X.Tz(); // the three ribs hanging over the court, their notches, and the relief's target line
              ribs.forEach((r, i) => { const cx = X.sx(8 + i * 8), cy = X.sy(1.4); c.save(); c.translate(cx, cy); c.strokeStyle = 'rgba(40,37,47,.5)'; c.lineWidth = 3; c.beginPath(); c.arc(0, 0, T * 1.1, 0, TAU); c.stroke();
                c.rotate(r.pos * Math.PI / 2); c.fillStyle = BONE; c.strokeStyle = LN; c.lineWidth = 2; c.beginPath(); c.ellipse(0, 0, T * 0.95, T * 0.35, 0, 0, TAU); c.fill(); c.stroke(); c.fillStyle = BASALT; c.fillRect(T * 0.55, -T * 0.14, T * 0.5, T * 0.28); c.restore();
                c.save(); c.translate(cx, cy); c.rotate(r.target * Math.PI / 2); c.strokeStyle = CYAN; c.lineWidth = 2; c.setLineDash([4, 4]); c.beginPath(); c.moveTo(T * 0.5, 0); c.lineTo(T * 1.4, 0); c.stroke(); c.restore();
                c.save(); c.font = `800 ${Math.round(T * 0.26)}px ${arcFont}`; c.textAlign = 'center'; c.fillStyle = r.pos === r.target ? CYAN : '#FFFFFF'; c.strokeStyle = 'rgba(0,0,0,.6)'; c.lineWidth = 3; c.strokeText(`Rib ${i + 1}`, cx, cy + T * 1.5); c.fillText(`Rib ${i + 1}`, cx, cy + T * 1.5); c.restore(); });
              if (aligned()) { c.save(); c.strokeStyle = CYAN; c.lineWidth = 6; c.globalAlpha = 0.8; c.beginPath(); c.moveTo(X.sx(5), X.sy(1.4)); c.lineTo(X.sx(27), X.sy(1.4)); c.stroke(); c.restore(); } },
          };
        } },
      /* 4. Orryx: the jaw-hinge chamber, a resonator in each corner, one to four bands */
      { kind: 'boss', name: 'The Jaw Hinge', boss: 'orryx', goal: 'Orryx the Listening Shell',
