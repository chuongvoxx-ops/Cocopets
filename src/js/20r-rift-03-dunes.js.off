        legend: Object.assign({ s: { tile: T_MUD }, 1: { tile: T_MUD }, 2: { tile: T_MUD }, 3: { tile: T_MUD }, p: {}, x: { tile: T_SOLID }, E: {} }, PACK),
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, routes = [marks['1'] || [], marks['2'] || [], marks['3'] || []];
          const pylons = marks.p.map((p, i) => H.obj({ x: p.x, y: p.y, kind: 'pylon', i, on: false, h: 1.6, label: o => (o.on ? '' : `Pylon ${i + 1}: light it`), use(o) { if (o.on) return; o.on = true; o.use = null; last = { x: o.x, y: o.y + 1 }; X.sfx.fanfare(); X.ring(o.x, o.y, 0.3, 4, 0.7, CYAN, 0.4); routes[i].forEach(q => X.setTile(q.tx, q.ty, T_FLOOR)); X.retile(); X.banner(`PYLON ${i + 1} LIT`, 'Its route turns to stone', CYAN, 2, true); },
            draw(c, Xs, Ys, T, o) { c.save(); c.translate(Xs, Ys); c.fillStyle = 'rgba(0,0,0,.25)'; c.beginPath(); c.ellipse(0, T * 0.12, T * 0.4, T * 0.16, 0, 0, TAU); c.fill(); c.fillStyle = BASALT; c.strokeStyle = LN; c.lineWidth = 2; c.beginPath(); c.moveTo(-T * 0.22, T * 0.05); c.lineTo(-T * 0.1, -T * 1.4); c.lineTo(T * 0.1, -T * 1.4); c.lineTo(T * 0.22, T * 0.05); c.closePath(); c.fill(); c.stroke(); if (o.on) glowAt(c, 0, -T * 1.45, T * 0.6, CYAN, 0.8); c.fillStyle = o.on ? CYAN : '#3F8A92'; c.beginPath(); c.arc(0, -T * 1.45, T * 0.14, 0, TAU); c.fill(); c.restore(); } }));
          let last = { x: X.M.start.x, y: X.M.start.y }, sandT = 0, erupt = 0, callK = 1;
          H.spawnPacks(); H.setExit(marks.E[0].x, marks.E[0].y, "Ultharak's bowl");
          X.after(2.4, () => X.banner('THE BURROW HUNT', 'Three seconds on soft sand and it erupts. Island to island', CYAN, 2.8, true, true));
          return { pylons, get sandT() { return sandT; },
            onCall(m) { callK = 3; X.after(2.4, () => { callK = 1; }); },
            update(dt) {
              if (me.dead) return;
              if (soft(X, me.x, me.y)) { if (erupt > 0) { erupt -= dt; if (erupt <= 0) { erupt = 0; sandT = 0; X.boom(me.x, me.y, 2, OCHRE, '#FFFFFF', { n: 24, shake: 12 }); X.hurtPet(X.ST().hp * 0.22, null); X.banner('ERUPTION', 'Back to the last secured island', '#FF9BD2', 1.8, true); X.sfx.crash(); me.x = last.x; me.y = last.y; } }
                else { sandT += dt * callK; if (sandT >= 3) { erupt = 1.5; X.warn({ x: me.x, y: me.y, r: 1.8, life: 1.5, max: 1.5, color: OCHRE, follow: me }); X.text(me.x, me.y - 1.2, 'The sand rises!', OCHRE, 13); X.sfx.wrong(); } } }
              else { sandT = 0; erupt = 0; }
              if (pylons.every(p => p.on) && !self.done && H.monstersLeft() === 0) { self.done = true; (marks.x || []).forEach(p => X.setTile(p.tx, p.ty, T_FLOOR)); X.retile(); X.banner('THE RAMP OPENS', 'Down into the sand bowl', '#8FE0A6', 2.4, true); X.flash(0.3, CYAN); X.sfx.fanfare(); }
            },
