            drawGround(c) { const T = X.Tz(); if (soft(X, me.x, me.y) && sandT > 0.3) { c.save(); c.globalAlpha = Math.min(0.8, sandT / 3); c.strokeStyle = erupt > 0 ? '#FF9BD2' : OCHRE; c.lineWidth = 3; c.beginPath(); c.ellipse(X.sx(me.x), X.sy(me.y), T * (0.6 + sandT * 0.2), T * (0.35 + sandT * 0.12), 0, 0, TAU); c.stroke(); c.restore(); } },
          };
        } },
      /* 6. Ultharak: the sand bowl inside the obelisk ring, three rock islands, two resonators, the mouth at the centre */
      { kind: 'boss', name: 'The Sand Bowl', boss: 'ultharak', goal: 'Ultharak the Sand Kraken',
        layout: [
          '########################################',
          '####................................####',
          '####................................####',
          '###..................................###',
          '###..................................###',
          '##......aaa..................aaa......##',
          '##.....aaaaa................aaaaa.....##',
          '##......aaa..................aaa......##',
          '##....................................##',
          '##.................B..................##',
          '##....................................##',
          '##..R..............................R..##',
          '##....................................##',
          '##....................................##',
          '##.................aaa................##',
          '###...............aaaaa..............###',
          '###................aaa...............###',
          '####...............S................####',
          '####................................####',
          '########################################'],
        legend: { B: {}, R: {}, a: {} },
        make(X, self, H) {
          const marks = X.M.marks, me = X.me, mod = { moundList: null, spiralT: 0, safe: -1, pullK: 1 };
          const isl = [[9, 6], [30, 6], [20, 15]].map(([x, y], i) => ({ x: x + 0.5, y: y + 0.5, i, tiles: marks.a.filter(q => Math.hypot(q.x - x - 0.5, q.y - y - 0.5) < 3.2) }));
          const onIsland = i => isl[i].tiles.some(q => Math.hypot(me.x - q.x, me.y - q.y) < 0.8), anyIsland = () => isl.some((_, i) => onIsland(i));
          const forks = marks.R.map((p, i) => mkFork(H, p, { bands: 2, label: o => (mod.moundList ? 'Sound it: read the mounds' : 'A resonator'), use(o) { o.ringT = 1.5; o.ringR = 0; X.sfx.hum(); if (!mod.moundList) { X.text(o.x, o.y - 1.6, 'Only the sand answers', '#FFFFFF', 12); return; } for (const m of X.mons) if (m.type === 'mound' && !m.dead) m.echo = m.real ? 'eye' : 'broken'; X.banner('THE ECHO RETURNS', 'An eye marks the true mound; broken rings the decoys', CYAN, 2.2, true); } }));
          mod.moundsBusy = () => !!mod.moundList;
