              if (mod.anchor && mod.anchor.dead) { mod.anchor = null; mod.pullK *= 0.5; m.hp -= m.maxhp * 0.04; m.flash = 0.2; X.text(m.x, m.y - m.r - 1.5, 'The pull weakens', CYAN, 13); X.sparks(m.x, m.y, CYAN, 16, 5); }
              mod.swapT -= dt; if (mod.swapT < 5 && !mod.warned) { mod.warned = true; mod.next = (mod.safe + 1 + Math.floor(Math.random() * 2)) % 3; X.banner('THE SWEEP SHIFTS', `In five seconds island ${mod.next + 1} is the free one`, '#FF9BD2', 2.2, true); }
              if (mod.swapT <= 0) { mod.safe = mod.next; mod.swapT = 99; if (mod.anchor && !mod.anchor.dead) X.killMon(mod.anchor); mod.anchor = null; spawnAnchor(m); }
              if (mod.spiralT <= 0) { mod.spiralT = 0; if (mod.anchor && !mod.anchor.dead) X.killMon(mod.anchor); mod.anchor = null; X.text(m.x, m.y - m.r - 1.5, 'The sand settles', '#FFFFFF', 12); } } };
          mod.goal = () => mod.moundList ? `Find the true mound · ${Math.ceil(mod.eruptT)}s` : mod.spiralT > 0 ? `Quicksand · island ${mod.safe + 1} is free · break the anchor` : 'Ultharak the Sand Kraken';
          mod.update = dt => { for (const o of forks) if (o.ringT > 0) { o.ringT -= dt; o.ringR += 5 * dt; } };
          mod.drawGround = c => { const T = X.Tz();
            isl.forEach((I, i) => { const safe = mod.spiralT > 0 && mod.safe === i; I.tiles.forEach(q => { const Xs = X.sx(q.x), Ys = X.sy(q.y); c.save(); c.fillStyle = safe ? '#7A8A86' : '#5A5A62'; c.strokeStyle = LN; c.lineWidth = 1.2; GFX.rr(c, Xs - T * 0.46, Ys - T * 0.5, T * 0.92, T * 0.84, 3); c.fill(); c.stroke(); c.restore(); });
              if (safe) { c.save(); c.globalCompositeOperation = 'lighter'; c.globalAlpha = 0.4 + 0.3 * Math.sin(X.g.t * 5); blitSized(c, glowSprite(CYAN), X.sx(I.x) - T * 3, X.sy(I.y) - T * 2.2, T * 6, T * 4.4); c.restore(); }
              c.save(); c.font = `800 ${Math.round(T * 0.3)}px ${arcFont}`; c.textAlign = 'center'; c.fillStyle = '#FFFFFF'; c.strokeStyle = 'rgba(0,0,0,.6)'; c.lineWidth = 3; c.strokeText(String(i + 1), X.sx(I.x), X.sy(I.y) - T * 1.4); c.fillText(String(i + 1), X.sx(I.x), X.sy(I.y) - T * 1.4); c.restore(); });
            if (mod.spiralT > 0) { const b = X.boss; if (b) { c.save(); c.globalAlpha = 0.35; c.strokeStyle = '#6A4A8A'; c.lineWidth = 2; for (let i = 1; i < 5; i++) { c.beginPath(); c.ellipse(X.sx(b.x), X.sy(b.y), T * i * 2.2 + ((X.g.t * 30) % (T * 2.2)), T * i * 1.3 + ((X.g.t * 18) % (T * 1.3)), 0, 0, TAU); c.stroke(); } c.restore(); } }
            for (const o of forks) if (o.ringT > 0) ringDraw(c, X, o.x, o.y, o.ringR, CYAN, o.ringT); };
          riftSealing(X, self, mod, { fall: 'THE KRAKEN STILLS', sub: 'The sand is still; the black sun closes like an eye', sigil: 'THE ECHO SIGIL', name: 'The Mouth Beneath the Dunes', color: CYAN, wound: { x: X.M.MW / 2, y: 4 } });
          return mod;
        } },
    ],
  });
})();
