            mod.moundList = spots.map((p, i) => { const q = X.spawnMon('mound', p.x, p.y, { pack: 534, real: i === real }); X.g.total++; return q; }); mod.eruptT = 11; X.banner('IT VANISHES', 'Three mounds: a resonator tells which is real. Break it', CYAN, 2.6, true); X.sfx.hum(); };
          mod.spiralBusy = () => mod.spiralT > 0;
          mod.spiral = m => { mod.spiralT = 12; mod.pullK = 1; mod.safe = Math.floor(Math.random() * 3); mod.swapT = 6; mod.warned = false; mod.sweepT = 0; mod.anchor = null;
            X.banner('QUICKSAND SPIRAL', `The mouth pulls. Island ${mod.safe + 1} is free: break the anchor there`, CYAN, 2.6, true); X.sfx.hum(); spawnAnchor(m); };
          const spawnAnchor = m => { const I = isl[mod.safe], q = X.freeSpot(I.x, I.y - 1, 0.45) || I; mod.anchor = X.spawnMon('anchor', q.x, q.y, { pack: 535 }); X.g.total++; X.text(q.x, q.y - 1.2, 'An anchor is exposed', CYAN, 12); };
          mod.bossTick = (m, dt) => {
            if (mod.moundList) { mod.eruptT -= dt; const real = mod.moundList.find(q => q.real);
              if (real.dead) { mod.moundList.forEach(q => { if (!q.dead) X.killMon(q); }); mod.moundList = null; m.under = false; m.x = real.x; m.y = real.y; X.unstick(m); m.vuln = 3.5; X.boom(m.x, m.y, 2.5, OCHRE, '#FFFFFF', { n: 24, shake: 10 }); X.banner('INTERRUPTED', 'The kraken surfaces, open', CYAN, 2, true); X.sfx.crash(); }
              else if (mod.eruptT <= 0) { mod.moundList.forEach(q => { if (!q.dead) X.killMon(q); }); mod.moundList = null; m.under = false; m.x = real.x; m.y = real.y; X.unstick(m); X.flash(0.5, OCHRE); X.shake(16, 0.6); X.boom(m.x, m.y, 5, OCHRE, '#FFFFFF', { n: 50, shake: 16 }); if (!anyIsland()) X.hurtPet(m.dmg * 2.5, m); else X.text(me.x, me.y - 1.4, 'Sheltered on the rock', '#8FE0A6', 13); X.banner('ERUPTION', anyIsland() ? 'The islands held' : 'Caught on the sand', OCHRE, 2, true); X.sfx.crash(); } }
            if (mod.spiralT > 0) { mod.spiralT -= dt; mod.sweepT += dt;
              if (!anyIsland()) { const a = Math.atan2(m.y - me.y, m.x - me.x); me.x += Math.cos(a) * 1.4 * mod.pullK * dt; me.y += Math.sin(a) * 1.4 * mod.pullK * dt; if (Math.hypot(me.x - m.x, me.y - me.y) < 0) {} if (Math.hypot(me.x - m.x, me.y - m.y) < m.r + 0.5 && me.inv <= 0) { X.hurtPet(m.dmg * 0.6, m); me.inv = 0.6; } }
              // the sweeps: the two islands that are not free, every 2.5 s
